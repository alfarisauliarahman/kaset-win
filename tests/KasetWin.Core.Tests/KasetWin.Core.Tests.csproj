<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KasetWin.Core.Tests — unit + property-based tests for Core.
    Property tests use CsCheck (library) per the design / tasks conventions.
    References Core only so tests run on the plain .NET runner (headless).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KasetWin.Core.Tests</RootNamespace>
    <AssemblyName>KasetWin.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Underscores are idiomatic in xUnit test method names. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CsCheck" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KasetWin.Core\KasetWin.Core.csproj" />
  </ItemGroup>

  <!--
    Sanitized InnerTube fixtures (Task 5.1). Copied to the test output directory
    preserving the per-surface folder structure so TestFixtures can load them
    when `dotnet test` runs from bin/. Fixtures contain NO real secrets/PII.
  -->
  <ItemGroup>
    <Content Include="Fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
