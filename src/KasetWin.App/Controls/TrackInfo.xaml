<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KasetWin.App.Controls.TrackInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center">

        <!-- Title: clickable to the album/single page when a browseId exists, plain text otherwise. -->
        <HyperlinkButton
            Click="OnTitleClick"
            Style="{StaticResource InlineLinkButtonStyle}"
            ToolTipService.ToolTip="Go to album"
            Visibility="{x:Bind HasAlbumLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Foreground="{ThemeResource HyperlinkButtonForeground}"
                MaxLines="1"
                Text="{x:Bind TitleText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </HyperlinkButton>
        <TextBlock
            MaxLines="1"
            Text="{x:Bind TitleText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind TitleIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- Artist: clickable to the primary artist page when a channel id exists, plain otherwise. -->
        <HyperlinkButton
            Click="OnArtistClick"
            Style="{StaticResource InlineLinkButtonStyle}"
            ToolTipService.ToolTip="Go to artist"
            Visibility="{x:Bind HasArtistLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Foreground="{ThemeResource HyperlinkButtonForeground}"
                MaxLines="1"
                Text="{x:Bind ArtistText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </HyperlinkButton>
        <TextBlock
            MaxLines="1"
            Opacity="0.7"
            Text="{x:Bind ArtistText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind ArtistIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource CaptionTextBlockStyle}" />

    </StackPanel>
</UserControl>
