<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KasetWin.App.Controls.TrackInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center">

        <!-- Title row: title (clickable to the album/single page when a browseId exists, plain
             otherwise) followed by an "E" explicit badge for explicit tracks. Static/trimmed for
             track rows; a scrolling marquee variant is used by the player bar (Large). -->
        <StackPanel
            Orientation="Horizontal"
            Visibility="{x:Bind ShowStaticTitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <HyperlinkButton
                Click="OnTitleClick"
                Style="{StaticResource InlineLinkButtonStyle}"
                ToolTipService.ToolTip="Go to album"
                Visibility="{x:Bind HasAlbumLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource HyperlinkButtonForeground}"
                    MaxLines="1"
                    Text="{x:Bind TitleText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock
                FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                MaxLines="1"
                Text="{x:Bind TitleText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind TitleIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Border
                Margin="6,0,0,0"
                Padding="4,0"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="3"
                Visibility="{x:Bind ShowExplicit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Opacity="0.8"
                    Text="E" />
            </Border>
        </StackPanel>

        <!-- Marquee title (player bar): the full, untrimmed title scrolls horizontally when it is
             wider than the fixed viewport; the code-behind clips the viewport and drives the slide. -->
        <Grid
            x:Name="MarqueeViewport"
            SizeChanged="OnMarqueeSizeChanged"
            Visibility="{x:Bind ShowMarqueeTitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel x:Name="MarqueeRow" Orientation="Horizontal" SizeChanged="OnMarqueeSizeChanged">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MarqueeShift" />
                </StackPanel.RenderTransform>
                <HyperlinkButton
                    Click="OnTitleClick"
                    Style="{StaticResource InlineLinkButtonStyle}"
                    ToolTipService.ToolTip="Buka album">
                    <TextBlock
                        x:Name="MarqueeText"
                        FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                        Text="{x:Bind TitleText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </HyperlinkButton>
                <Border
                    Margin="6,0,0,0"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="3"
                    Visibility="{x:Bind ShowExplicit, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="E" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Second line: "Artist — Album" on one row. Artist and album are each clickable when a
             navigation id exists; the album half only appears when opted in (player bar). -->
        <StackPanel
            Margin="0,-2,0,0"
            Orientation="Horizontal"
            Visibility="{x:Bind ShowStaticTitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <HyperlinkButton
                Click="OnArtistClick"
                Style="{StaticResource InlineLinkButtonStyle}"
                ToolTipService.ToolTip="Go to artist"
                Visibility="{x:Bind HasArtistLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    FontSize="{x:Bind SubFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource HyperlinkButtonForeground}"
                    MaxLines="1"
                    Text="{x:Bind ArtistText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock
                FontSize="{x:Bind SubFontSize, Mode=OneWay}"
                MaxLines="1"
                Opacity="0.7"
                Text="{x:Bind ArtistText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ArtistIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock
                Margin="4,0"
                Opacity="0.5"
                Text="—"
                Visibility="{x:Bind ShowAlbumLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <HyperlinkButton
                Click="OnTitleClick"
                Style="{StaticResource InlineLinkButtonStyle}"
                ToolTipService.ToolTip="Go to album"
                Visibility="{x:Bind AlbumLineIsLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Foreground="{ThemeResource HyperlinkButtonForeground}"
                    MaxLines="1"
                    Opacity="0.75"
                    Text="{x:Bind AlbumText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock
                MaxLines="1"
                Opacity="0.55"
                Text="{x:Bind AlbumText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind AlbumLineIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Marquee second line (player bar): "Artist — Album" scrolls when wider than the viewport. -->
        <Grid
            x:Name="SubViewport"
            Margin="0,-2,0,0"
            SizeChanged="OnMarqueeSizeChanged"
            Visibility="{x:Bind ShowMarqueeTitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel x:Name="SubRow" Orientation="Horizontal" SizeChanged="OnMarqueeSizeChanged">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="SubShift" />
                </StackPanel.RenderTransform>
                <HyperlinkButton
                    Click="OnArtistClick"
                    Style="{StaticResource InlineLinkButtonStyle}"
                    ToolTipService.ToolTip="Buka halaman artis">
                    <TextBlock
                        FontSize="{x:Bind SubFontSize, Mode=OneWay}"
                        Opacity="0.85"
                        Text="{x:Bind ArtistText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </HyperlinkButton>
                <TextBlock
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Opacity="0.5"
                    Text="—"
                    Visibility="{x:Bind ShowAlbumLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <HyperlinkButton
                    Click="OnTitleClick"
                    Style="{StaticResource InlineLinkButtonStyle}"
                    ToolTipService.ToolTip="Buka album"
                    Visibility="{x:Bind ShowAlbumLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="{x:Bind SubFontSize, Mode=OneWay}"
                        Opacity="0.7"
                        Text="{x:Bind AlbumText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </HyperlinkButton>
            </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
