<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KasetWin.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />
        <converters:RepeatGlyphConverter x:Key="RepeatGlyph" />
        <converters:RepeatModeToOpacityConverter x:Key="RepeatOpacity" />
        <converters:BoolToOpacityConverter x:Key="BoolOpacity" />
        <converters:MuteGlyphConverter x:Key="MuteGlyph" />
        <converters:SecondsToTimeConverter x:Key="SecondsToTime" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CoverDimensionConverter x:Key="CoverDimension" />
    </UserControl.Resources>

    <!--
        Docked player bar (Apple-Music layout): transport on the LEFT, a centered now-playing card
        (rounded cover + title/artist·album, left-aligned, with the seek bar + times underneath) in
        the MIDDLE, and lyrics/queue/volume on the RIGHT. Full-width bar along the bottom of the
        content area, starting where the sidebar ends.
    -->
    <Grid
        Padding="16,3"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: transport controls -->
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Button
                x:Name="ShuffleButton"
                AutomationProperties.Name="Shuffle"
                Click="OnShuffleClick"
                Opacity="{Binding IsShuffled, Converter={StaticResource BoolOpacity}}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Shuffle">
                <FontIcon FontSize="16" Glyph="&#xE8B1;" />
            </Button>
            <Button
                x:Name="PreviousButton"
                AutomationProperties.Name="Previous"
                Click="OnPreviousClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Previous">
                <FontIcon FontSize="16" Glyph="&#xE892;" />
            </Button>
            <!-- Podcast-only: jump back 10s (YouTube convention). -->
            <Button
                x:Name="Rewind10Button"
                AutomationProperties.Name="Back 10 seconds"
                Click="OnRewind10Click"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Back 10 seconds"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="&#xEB9E;" />
            </Button>
            <Button
                x:Name="PlayPauseButton"
                AutomationProperties.Name="Play/Pause"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnPlayPauseClick"
                CornerRadius="18"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Play/Pause">
                <FontIcon FontSize="16" Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}" />
            </Button>
            <!-- Podcast-only: jump forward 30s (YouTube convention). -->
            <Button
                x:Name="Forward30Button"
                AutomationProperties.Name="Forward 30 seconds"
                Click="OnForward30Click"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Forward 30 seconds"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="&#xEB9D;" />
            </Button>
            <Button
                x:Name="NextButton"
                AutomationProperties.Name="Next"
                Click="OnNextClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Next">
                <FontIcon FontSize="16" Glyph="&#xE893;" />
            </Button>
            <Button
                x:Name="RepeatButton"
                AutomationProperties.Name="Repeat"
                Click="OnRepeatClick"
                Opacity="{Binding RepeatMode, Converter={StaticResource RepeatOpacity}}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Repeat">
                <FontIcon FontSize="16" Glyph="{Binding RepeatMode, Converter={StaticResource RepeatGlyph}}" />
            </Button>
        </StackPanel>

        <!-- CENTER: now-playing group. Fills the middle column (wide → long seek bar). The inner
             Row 0 is a responsive grid (TrackInfo in a * column) so it shrinks in a narrow window
             instead of overflowing/clipping. -->
        <Border
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Padding="8,2"
            Background="Transparent">
            <Grid RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: cover + title + like as ONE group above the progress bar (love sits right
                     next to the title). Responsive by design: TrackInfo sits in the near-all-star
                     column, so at the 980px minimum width it SHRINKS (and its marquee scrolls the
                     title) instead of overflowing and clipping the like button — while the trailing
                     hair-weight star column soaks up the surplus on a wide window so the group keeps
                     hugging the cover instead of drifting apart. The column MaxWidth replaces the old
                     fixed MaxWidth="340" on TrackInfo, which was the truncation culprit. -->
                <Grid
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1000*" MaxWidth="520" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                        <!-- Rounded cover; aspect adapts to the track (16:9 for a video, square otherwise) -->
                        <Border
                            Grid.Column="0"
                            Width="{Binding CurrentTrack, Converter={StaticResource CoverDimension}, ConverterParameter=w}"
                            Height="{Binding CurrentTrack, Converter={StaticResource CoverDimension}, ConverterParameter=h}"
                            VerticalAlignment="Center"
                            CornerRadius="6">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="CtxPlayNextItem" Click="OnCtxPlayNext" Text="Play next">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE893;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CtxAddToQueueItem" Click="OnCtxAddToQueue" Text="Add to queue">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CtxToggleLikeItem" Click="OnCtxToggleLike" Text="Like / unlike">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEB51;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CtxGoToArtistItem" Click="OnCtxGoToArtist" Text="Go to artist">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CtxGoToAlbumItem" Click="OnCtxGoToAlbum" Text="Go to album">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE93C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CtxShareItem" Click="OnCtxShare" Text="Share">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                            <!-- Decorative: the title/artist right next to it already carry the
                                 information, so Narrator should not stop on the artwork. -->
                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{Binding CurrentTrack.ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                Stretch="UniformToFill" />
                        </Border>
                        <controls:TrackInfo
                            x:Name="BarTrackInfo"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Large="True"
                            ShowAlbum="True"
                            Song="{Binding CurrentTrack}" />
                        <!-- LIVE + like + dislike travel together in one Auto column so they stay
                             right beside the title. -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                VerticalAlignment="Center"
                                Padding="6,2"
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                CornerRadius="4"
                                Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="LIVE"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                x:Name="LikeButton"
                                AutomationProperties.Name="Like"
                                VerticalAlignment="Center"
                                Click="OnLikeClick"
                                IsEnabled="False"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Like">
                                <FontIcon x:Name="LikeIcon" FontSize="16" Glyph="&#xEB51;" />
                            </Button>
                            <!-- Podcast-only: dislike (thumbs down), mirrors YT Music's episode rating. -->
                            <Button
                                x:Name="DislikeButton"
                                AutomationProperties.Name="Dislike"
                                VerticalAlignment="Center"
                                Click="OnDislikeClick"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Dislike"
                                Visibility="Collapsed">
                                <FontIcon x:Name="DislikeIcon" FontSize="16" Glyph="&#xE8E0;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                <!-- Row 1: progress bar spanning the full card width -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        MinWidth="36"
                        HorizontalTextAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Text="{Binding Progress, Converter={StaticResource SecondsToTime}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Slider
                        x:Name="SeekSlider"
                        AutomationProperties.Name="Playback position"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Maximum="{Binding Duration}"
                        Minimum="0"
                        StepFrequency="1"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="36"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Text="{Binding Duration, Converter={StaticResource SecondsToTime}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT: lyrics / queue / volume -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Name="SpeedButton"
                AutomationProperties.Name="Playback speed"
                VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Playback speed">
                <FontIcon FontSize="16" Glyph="&#xEC4A;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="SpeedFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <!-- Sleep timer: armed from this flyout, ticked by the bar, enforced by Core's SleepTimer. -->
            <Button
                x:Name="SleepTimerButton"
                AutomationProperties.Name="Sleep timer"
                VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Sleep timer">
                <!--
                    The moon alone only says "a timer exists", not how long is left. The badge puts
                    the remaining minutes on the button itself, so the state is readable without
                    hovering for a tooltip.
                -->
                <Grid>
                    <FontIcon x:Name="SleepTimerIcon" FontSize="16" Glyph="&#xEC46;" />
                    <Border
                        x:Name="SleepTimerBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-6,-5"
                        Padding="3,0"
                        MinWidth="13"
                        CornerRadius="7"
                        Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock
                            x:Name="SleepTimerBadgeText"
                            FontSize="9"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="SleepTimerFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <Button
                x:Name="LyricsButton"
                AutomationProperties.Name="Lyrics"
                VerticalAlignment="Center"
                Click="OnLyricsClick"
                IsEnabled="False"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Lyrics">
                <FontIcon x:Name="LyricsIcon" FontSize="16" Glyph="&#xE8D2;" />
            </Button>
            <Button
                x:Name="QueueButton"
                AutomationProperties.Name="Queue"
                VerticalAlignment="Center"
                Click="OnQueueClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Queue">
                <FontIcon FontSize="16" Glyph="&#xE90B;" />
            </Button>
            <!-- Mini player: shrinks the window to a compact always-on-top overlay. -->
            <Button
                x:Name="MiniPlayerButton"
                AutomationProperties.Name="Mini player"
                VerticalAlignment="Center"
                Click="OnMiniPlayerClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Mini player">
                <FontIcon FontSize="16" Glyph="&#xEE49;" />
            </Button>
            <Button
                x:Name="MuteButton"
                AutomationProperties.Name="Mute"
                Click="OnMuteClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Mute">
                <FontIcon FontSize="16" Glyph="{Binding IsMuted, Converter={StaticResource MuteGlyph}}" />
            </Button>
            <Slider
                x:Name="VolumeSlider"
                AutomationProperties.Name="Volume"
                Width="100"
                Maximum="100"
                Minimum="0"
                ValueChanged="OnVolumeChanged"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
