<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KasetWin.App.Controls.NowPlayingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:CoverArtConverter x:Key="CoverArt" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:DurationToTextConverter x:Key="DurationToText" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:ActiveLineToFontWeightConverter x:Key="ActiveLineToFontWeight" />
        <converters:ActiveLineToScaleConverter x:Key="ActiveLineToScale" />
        <converters:ActiveLineToFontSizeConverter x:Key="ActiveLineToFontSize" />

        <DataTemplate x:Key="PanelRowTemplate" x:DataType="models:Song">
            <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4">
                    <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                </Border>
                <controls:TrackInfo Grid.Column="1" Song="{x:Bind}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: mode tabs + close -->
        <Grid Grid.Row="0" Padding="10,12,8,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Queue sub-tabs (Berikutnya / Riwayat), shown in queue mode. -->
            <SelectorBar
                x:Name="QueueTabs"
                Grid.Column="0"
                SelectionChanged="OnQueueTabChanged"
                Visibility="{x:Bind IsQueue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <SelectorBar.Resources>
                    <!-- Compact tabs so three fit the 380px panel without overflow scroll arrows. -->
                    <Thickness x:Key="SelectorBarItemPadding">8,4,8,4</Thickness>
                </SelectorBar.Resources>
                <SelectorBarItem x:Name="UpNextTab" IsSelected="True" Text="Up next" />
                <SelectorBarItem x:Name="HistoryTab" Text="History" />
                <SelectorBarItem x:Name="RelatedTab" Text="Related" />
            </SelectorBar>

            <!-- The lyrics body is padded 20px from the panel edge while this header grid only pads
                 10px, so the title needs the extra 10px to sit on the same vertical line as the text. -->
            <StackPanel
                Grid.Column="0"
                Margin="10,0,0,0"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind IsLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind LyricsHeaderText, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!-- Subtitle/CC track picker (podcast episodes only): Nonaktif + the video's tracks. -->
                <Button
                    x:Name="CcPickerButton"
                    AutomationProperties.Name="Choose subtitles"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Choose subtitles"
                    Visibility="{x:Bind ShowCcPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE190;" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="CcFlyout" Opening="OnCcFlyoutOpening" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Button
                x:Name="CloseButton"
                AutomationProperties.Name="Close"
                Grid.Column="1"
                Click="OnCloseClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- ══ QUEUE ══ -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind IsQueue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

            <!-- Berikutnya: now playing + up next (reorderable) -->
            <ScrollViewer
                x:Name="UpNextScroller"
                Padding="12,0,12,16"
                Visibility="{x:Bind ShowUpNext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="4">
                    <!-- Sudah diputar: the part of the queue behind the current track. Kept in the
                         list (dimmed) instead of only living in the Riwayat tab, so the queue reads
                         as one continuous strip — played → now playing → up next — and an earlier
                         track can be clicked to play again. -->
                    <TextBlock
                        x:Name="PlayedHeaderText"
                        Margin="8,8,0,0"
                        Opacity="0.6"
                        Text="Played"
                        Visibility="{x:Bind Queue.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ListView
                        x:Name="PlayedList"
                        AutomationProperties.Name="Already played tracks"
                        IsItemClickEnabled="True"
                        ItemClick="OnTrackClick"
                        ItemTemplate="{StaticResource PanelRowTemplate}"
                        ItemsSource="{x:Bind Queue.History, Mode=OneWay}"
                        Opacity="0.5"
                        PointerWheelChanged="OnUpNextWheel"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="None"
                        Visibility="{x:Bind Queue.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        x:Name="NowPlayingHeaderText"
                        Margin="8,8,0,0"
                        Opacity="0.6"
                        Text="Now playing"
                        Visibility="{x:Bind Queue.HasNowPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid
                        x:Name="NowPlayingCard"
                        Padding="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        ColumnSpacing="12"
                        Visibility="{x:Bind Queue.HasNowPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Height="40" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="4">
                            <!-- Bound to the whole Song (not .ThumbnailUrl) so the converter can
                                 fall back to FallbackThumbnailUrl and log load failures (#150). -->
                            <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind Queue.NowPlaying, Converter={StaticResource CoverArt}, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <controls:TrackInfo x:Name="NowPlayingTrackInfo" Grid.Column="2" VerticalAlignment="Center" Song="{x:Bind Queue.NowPlaying, Mode=OneWay}" />
                    </Grid>

                    <TextBlock
                        x:Name="UpNextHeaderText"
                        Margin="8,8,0,0"
                        Opacity="0.6"
                        Text="Up next"
                        Visibility="{x:Bind Queue.HasUpNext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ListView
                        x:Name="UpNextList"
                        AutomationProperties.Name="Playback queue"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        IsItemClickEnabled="True"
                        ItemClick="OnTrackClick"
                        ItemTemplate="{StaticResource PanelRowTemplate}"
                        ItemsSource="{x:Bind Queue.UpNext, Mode=OneWay}"
                        PointerWheelChanged="OnUpNextWheel"
                        ReorderMode="Enabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="None" />

                    <StackPanel
                        Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind Queue.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="QueueEmptyText" HorizontalAlignment="Center" Opacity="0.6" Text="No upcoming songs." Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Riwayat -->
            <ListView
                x:Name="HistoryList"
                AutomationProperties.Name="Playback history"
                Padding="12,4,12,16"
                IsItemClickEnabled="True"
                ItemClick="OnTrackClick"
                ItemTemplate="{StaticResource PanelRowTemplate}"
                ItemsSource="{x:Bind Queue.History, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ShowHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!-- Terkait (related): watch-next carousels for the current track. -->
            <Grid Visibility="{x:Bind ShowRelated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.Resources>
                    <!-- All-song sections: compact rows, 4 down then across (column-major). -->
                    <DataTemplate x:Key="RelatedSongsTemplate" x:DataType="vm:HomeSectionView">
                        <StackPanel Margin="0,0,0,8" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ScrollViewer
                                Padding="0,0,0,14"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <muxc:ItemsRepeater ItemsSource="{x:Bind Items}">
                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:UniformGridLayout
                                            MaximumRowsOrColumns="4"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="2"
                                            Orientation="Vertical" />
                                    </muxc:ItemsRepeater.Layout>
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HomeCardItem">
                                            <Grid
                                                Width="300"
                                                Height="56"
                                                Padding="4"
                                                Background="Transparent"
                                                ColumnSpacing="10"
                                                CornerRadius="6"
                                                DataContext="{x:Bind}"
                                                Tapped="OnRelatedItemClick">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center" CornerRadius="4">
                                                    <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Opacity="0.6"
                                                        Text="{x:Bind Subtitle}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Playlist / artist / album sections: horizontal card rail. -->
                    <DataTemplate x:Key="RelatedCardsTemplate" x:DataType="vm:HomeSectionView">
                        <StackPanel Margin="0,0,0,8" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ScrollViewer
                                Padding="0,0,0,14"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HomeCardItem">
                                            <StackPanel
                                                Width="120"
                                                Background="Transparent"
                                                Spacing="2"
                                                Tapped="OnRelatedItemClick">
                                                <Border
                                                    Width="120"
                                                    Height="120"
                                                    Margin="0,0,0,4"
                                                    CornerRadius="{x:Bind ImageCornerRadius}">
                                                    <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    MaxLines="2"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock
                                                    MaxLines="1"
                                                    Opacity="0.6"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>

                    <controls:RelatedSectionTemplateSelector
                        x:Key="RelatedTemplateSelector"
                        CardsTemplate="{StaticResource RelatedCardsTemplate}"
                        SongsTemplate="{StaticResource RelatedSongsTemplate}" />
                </Grid.Resources>

                <ScrollViewer Padding="12,4,12,16">
                    <StackPanel>
                        <ItemsControl ItemTemplateSelector="{StaticResource RelatedTemplateSelector}" ItemsSource="{x:Bind RelatedSections, Mode=OneWay}" />

                        <!-- Tentang artis (bio) at the bottom, matching YT Music's Related tab. -->
                        <StackPanel
                            Margin="0,8,0,0"
                            Spacing="8"
                            Visibility="{x:Bind HasAbout, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind AboutTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Opacity="0.75"
                                Text="{x:Bind AboutText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ProgressRing
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    IsActive="{x:Bind IsRelatedLoading, Mode=OneWay}"
                    Visibility="{x:Bind IsRelatedLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    x:Name="RelatedEmptyText"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="No related content."
                    TextAlignment="Center"
                    Visibility="{x:Bind RelatedIsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </Grid>
        </Grid>

        <!-- ══ LYRICS ══ -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind IsLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <!-- Row 0 holds the lyrics body (synced list / plain text / empty state); row 1 is
                     the provider attribution pinned under it. -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="LyricsList"
                AutomationProperties.Name="Lyrics"
                Padding="20,4,20,24"
                HorizontalContentAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="OnLyricLineClick"
                ItemsSource="{x:Bind Lyrics.Lines, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind Lyrics.ShowSynced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LyricLineItem">
                        <StackPanel>
                            <!-- Active line grows via FONT SIZE (layout-aware, so it wraps instead of being
                                 clipped) + brightens; opacity animates smoothly as the current line changes. -->
                            <TextBlock
                                Margin="0,8"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind IsActive, Converter={StaticResource ActiveLineToFontSize}, Mode=OneWay}"
                                FontWeight="{x:Bind IsActive, Converter={StaticResource ActiveLineToFontWeight}, Mode=OneWay}"
                                Opacity="{x:Bind IsActive, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ShowPlainText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource SubtitleTextBlockStyle}">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.35" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                            <!-- Karaoke rendering for the active line when word timing exists (podcast
                                 auto-subtitles): the spoken part lights up word by word. -->
                            <TextBlock
                                Margin="0,8"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind IsActive, Converter={StaticResource ActiveLineToFontSize}, Mode=OneWay}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ShowKaraoke, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource SubtitleTextBlockStyle}"><Run Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind SungText, Mode=OneWay}" /><Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind UnsungText, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Trailing spacer: lets the LAST lyric lines still scroll up to the top of the
                     viewport (Apple Music behaviour). Height is set from the live viewport height in
                     code-behind; 0 costs nothing when lyrics are short or absent. -->
                <ListView.Footer>
                    <Border x:Name="LyricsTailSpacer" Height="0" />
                </ListView.Footer>
            </ListView>

            <ScrollViewer
                Padding="20,4,20,24"
                Visibility="{x:Bind Lyrics.ShowPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind Lyrics.PlainText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
            </ScrollViewer>

            <TextBlock
                x:Name="LyricsEmptyText"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6"
                Text="Play a song to see its lyrics here."
                TextAlignment="Center"
                Visibility="{x:Bind Lyrics.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource BodyTextBlockStyle}" />

            <!-- "Sumber: <provider>" — credits whichever lyrics provider answered (LRCLib, NetEase,
                 YouTube captions). Subdued so it reads as a footnote, not as a lyric line. -->
            <TextBlock
                x:Name="LyricsSourceLabel"
                Grid.Row="1"
                Margin="20,0,20,12"
                HorizontalAlignment="Left"
                Opacity="0.5"
                Text="{x:Bind LyricsSourceText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind HasLyricsSource, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</UserControl>
