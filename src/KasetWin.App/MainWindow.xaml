<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KasetWin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:core="using:KasetWin.Core.Models"
    Title="Kaset">

    <!-- Native Windows 11 Fluent shell: Mica backdrop behind the whole window (Req 1.4 shell). -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        RootGrid is preserved as the mount point for the hidden playback WebView2 (Task 8.3): the
        code-behind inserts PlaybackWebViewHost.Element at child index 0. Row 0 hosts the offline
        connectivity indicator (Req 35.3), row 1 hosts the NavigationView + content Frame, row 2
        hosts the bottom PlayerBar.
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Custom title bar (Req: back button inline with the app icon + name, like Media Player).
            The window extends content into the title bar (code-behind) and SetTitleBar() designates
            TitleBarDragRegion as the drag area; the back button sits outside it so it stays clickable
            and only appears when the content frame has back history.
        -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TitleBarBackButton"
                AutomationProperties.Name="Back"
                Grid.Column="0"
                Width="40"
                Height="32"
                Margin="6,0,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnTitleBarBackClick"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image
                        Width="18"
                        Height="18"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/Square44x44Logo.png" />
                    <TextBlock
                        x:Name="AppTitleText"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Kaset" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--
            Row 1 is intentionally empty (it collapses to zero height). The offline indicator used to
            live here as a layout row, which meant losing connectivity pushed the entire app down by
            the banner's height and regaining it snapped everything back up — a jarring reflow on an
            event the user did not cause. It is now an overlay inside the content area (below), so
            appearing and disappearing costs no layout.
        -->

        <!-- Row 2: main content (NavigationView) + the docked right-hand now-playing side panel. -->
        <Grid Grid.Row="2">

        <!--
            Mini player (CompactOverlay). Sits in the same row as the NavigationView and swaps places
            with it, so the hidden playback WebView2 mounted on RootGrid is never re-parented —
            re-parenting it would tear playback down.
        -->
        <controls:MiniPlayerView x:Name="MiniPlayerHost" Visibility="Collapsed" />

        <!--
            Responsive sidebar: PaneDisplayMode=Auto lets the NavigationView adapt to the window
            width like the Windows 11 shell apps (Media Player / Store). The default expanded
            threshold (1008) was invisible in practice because the window's minimum width is 980
            (MainWindowLayout), leaving a 28px compact band; 1200 makes the adaptation real:
            >= 1200 expanded, below it compact (icons only). Minimal (< 641 default) is unreachable
            behind the 980 floor and left as-is. The hamburger + source-toggle swap follow the
            effective mode in OnNavViewDisplayModeChanged (MainWindow.SidePanel.cs), which also
            covers the side panel pinning the pane to LeftCompact.
        -->
        <NavigationView
            x:Name="NavView"
            Grid.Column="0"
            DisplayModeChanged="OnNavViewDisplayModeChanged"
            ExpandedModeThresholdWidth="1200"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            Loaded="OnNavViewLoaded"
            PaneDisplayMode="Auto"
            BackRequested="OnNavigationBackRequested"
            Expanding="OnNavItemExpanding"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <!--
                Source toggle (ADR 0020 equivalent): switches the sidebar between the YouTube Music
                surfaces and the regular YouTube surfaces, showing only the active source's items.
            -->
            <!-- Sidebar search (top of pane): search-as-you-type with rich YT Music suggestions. -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SidebarSearchBox"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    QuerySubmitted="OnSidebarSearchQuerySubmitted"
                    TextChanged="OnSidebarSearchTextChanged"
                    TextMemberPath="Query">
                    <AutoSuggestBox.ItemTemplate>
                        <!-- Classic {Binding}: x:Bind is unsupported in Window-level templates. -->
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="14"
                                    Glyph="&#xE81C;"
                                    Opacity="0.6"
                                    Visibility="{Binding IsHistory, Converter={StaticResource GlobalBoolToVisibility}}" />
                                <Border
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Visibility="{Binding IsRich, Converter={StaticResource GlobalBoolToVisibility}}">
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource GlobalUriToImageSource}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        MaxLines="1"
                                        Text="{Binding Query}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="1"
                                        Opacity="0.65"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasSubtitle, Converter={StaticResource GlobalBoolToVisibility}}" />
                                </StackPanel>
                                <!-- Delete this entry from the local search history. -->
                                <Button
                                    Grid.Column="2"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Remove from history"
                                    Click="OnDeleteHistoryClick"
                                    Loaded="OnDeleteHistoryLoaded"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Remove from history"
                                    Visibility="{Binding IsHistory, Converter={StaticResource GlobalBoolToVisibility}}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <!-- Source toggle lives at the BOTTOM of the pane (above the account footer), native
                 SelectorBar styling. -->
            <NavigationView.PaneFooter>
              <Grid>
                <!-- Compact source toggle: shown whenever the pane is collapsed to icons — a panel is
                     open or the window is too narrow for the expanded pane (UpdatePaneChrome). A round
                     icon-only button, like the account avatar; a click flips the source.
                     The 6px side margins are load-bearing: the PaneFooter presenter left-aligns
                     sized-to-content footer content, so a bare 36px button hugged x=0 and sat 6px
                     left of the compact rail's centre (nav icons centre at 24 of the 48px rail).
                     36 + 6 + 6 = 48 puts the button's centre at 24 to match them. -->
                <Button
                    x:Name="SourceToggleCompact"
                    AutomationProperties.Name="Source: Music or YouTube"
                    Width="36"
                    Height="36"
                    Margin="6,0,6,8"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Click="OnSourceToggleCompactClick"
                    CornerRadius="18"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="SourceCompactIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="&#xE8D6;" />
                </Button>

                <!-- Segmented pill (per the reference shot), native SelectorBar inside. -->
                <Border
                    x:Name="SourceTogglePill"
                    Margin="8,0,8,8"
                    Padding="3"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="22">
                    <Grid>
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                        </Grid.Resources>

                        <!-- Sliding accent indicator that glides between the two segments. -->
                        <Border
                            x:Name="SourceIndicator"
                            Width="96"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="20">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SourceIndicatorTransform" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <ToggleButton
                                x:Name="MusicSourceItem"
                                AutomationProperties.Name="Music source"
                                Width="96"
                                MinWidth="0"
                                Padding="0,7"
                                HorizontalContentAlignment="Center"
                                Click="OnSourceToggleClick"
                                CornerRadius="20"
                                Style="{StaticResource SourceToggleButtonStyle}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <FontIcon FontSize="14" Glyph="&#xE8D6;" />
                                    <TextBlock Text="Music" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="YouTubeSourceItem"
                                AutomationProperties.Name="YouTube source"
                                Width="96"
                                MinWidth="0"
                                Padding="0,7"
                                HorizontalContentAlignment="Center"
                                Click="OnSourceToggleClick"
                                CornerRadius="20"
                                Style="{StaticResource SourceToggleButtonStyle}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <FontIcon FontSize="14" Glyph="&#xE714;" />
                                    <TextBlock Text="YouTube" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>
              </Grid>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explore" Tag="Explore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Liked Songs" Tag="LikedSongs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB52;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Podcasts is prepared but hidden until region availability is wired (Req 27, advanced). -->
                <NavigationViewItem
                    x:Name="PodcastsItem"
                    Content="Podcasts"
                    Tag="Podcasts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Expandable playlists tree, last in the music section. The header row carries an
                     inline "+" (new playlist); children are populated from the library in code. -->
                <NavigationViewItem
                    x:Name="PlaylistsNavItem"
                    SelectsOnInvoked="False"
                    Tag="PlaylistsRoot">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlaylistsRootLabel" VerticalAlignment="Center" Text="Playlists" />
                            <Button
                                x:Name="NewPlaylistButton"
                                AutomationProperties.Name="New playlist"
                                Grid.Column="1"
                                Padding="4"
                                VerticalAlignment="Center"
                                Click="OnNewPlaylistClick"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="New playlist">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- YouTube (full mode) section (Req 32.1/32.4). Shown only when the YouTube source
                     is selected in the pane-header toggle. -->
                <NavigationViewItemHeader x:Name="YouTubeHeader" Content="YouTube" />
                <NavigationViewItem Content="YouTube Home" Tag="YouTube.Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explore" Tag="YouTube.Explore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Subscriptions" Tag="YouTube.Subscriptions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shorts" Tag="YouTube.Shorts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE786;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="YouTube History" Tag="YouTube.History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!--
                Account / sign-in entry point (Req 4.2). SelectsOnInvoked=False so invoking it runs
                the Google sign-in flow (handled in OnNavigationItemInvoked) instead of navigating.
                The label reflects the auth state (Sign in ⇄ Account).
            -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SignInItem"
                    Content="Sign in"
                    Tag="SignIn"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--
                Content region + the docked player bar as a bottom row. The now-playing side panel
                (Queue / Lyrics) lives in the TOP row alongside the content, so opening it shrinks the
                content only — never the player bar, which spans the full width of the bottom row.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Frame x:Name="ContentFrame" Grid.Column="0" />
                    <controls:NowPlayingPanel
                        x:Name="SidePanel"
                        Grid.Column="1"
                        Visibility="Collapsed" />
                </Grid>

                <!--
                    Offline indicator (Req 35.3): shown while the device has no connectivity, hidden
                    when back online. IsOpen is driven from the code-behind via
                    INetworkMonitor.ConnectivityChanged. Non-closable so the user cannot dismiss a
                    still-accurate offline state.

                    Floats over the top of the content area rather than occupying a layout row, so
                    connectivity changes never reflow the shell. It shares Row 0 with the content
                    frame and so never covers the player bar.
                -->
                <InfoBar
                    x:Name="OfflineInfoBar"
                    Grid.Row="0"
                    Margin="12,12,12,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Title="Offline"
                    CornerRadius="8"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Connectivity is unavailable. Some features may not work until you're back online."
                    Severity="Warning" />

                <!-- Global in-app notification: floats at the bottom of the CONTENT area, above the
                     player bar (Row 1), so it never overlaps/collides with the transport. -->
                <InfoBar
                    x:Name="ToastBar"
                    Grid.Row="0"
                    Width="320"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    IsClosable="True"
                    IsOpen="False" />

                <controls:PlayerBar x:Name="PlayerBarControl" Grid.Row="1" />
            </Grid>
        </NavigationView>
        </Grid>

        <!--
            In-app sign-in result notification (Req 4.3). Shown as a light-dismiss TeachingTip
            anchored above the account footer item, so a successful/failed sign-in is confirmed
            right where the user acted, without a system toast. Target + text + IsOpen are driven
            from the code-behind after the login flow resolves.
        -->
        <TeachingTip
            x:Name="LoginTip"
            Grid.Row="2"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top" />

    </Grid>
</Window>
