<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KasetWin.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide converters for templates hosted outside a Page (e.g. the shell's sidebar
                 search suggestions, which live on the Window and have no Page.Resources). -->
            <converters:UriToImageSourceConverter x:Key="GlobalUriToImageSource" />
            <converters:BoolToVisibilityConverter x:Key="GlobalBoolToVisibility" />

            <!--
                Subtle (chromeless) button used across PlayerBar / Search / Library for icon and
                list-row buttons. WinUI 3 has no built-in "SubtleButtonStyle", so it is defined
                here once, app-wide, based on the default Button style with a transparent
                background/border so it reads as a low-emphasis affordance.
            -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <!--
                Inline, text-like hyperlink used wherever an artist name or a song/album title should
                read as plain text but navigate on click (PlayerBar now-playing, track rows, Search
                results, Lyrics header). Strips the default HyperlinkButton chrome (padding / min
                size) so it sits inline with surrounding text; the accent foreground + hover
                underline come from the base HyperlinkButton style.
            -->
            <Style x:Key="InlineLinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!--
                Segmented source-toggle button (Music / YouTube pill in the pane footer). Overrides the
                default ToggleButton theme brushes so the CHECKED (active) segment fills with the system
                accent + white text (a clear highlight), while the unchecked segment is transparent so
                the surrounding pill shows through. Rounded via CornerRadius set on each button.
            -->
            <Style x:Key="SourceToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
