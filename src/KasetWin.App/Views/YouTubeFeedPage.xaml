<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.YouTubeFeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />

        <DataTemplate x:Key="YouTubeFeedCardTemplate" x:DataType="models:YouTubeVideo">
            <Grid Width="260" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Height="146"
                    CornerRadius="8">
                    <Image
                        Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ChannelName}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ViewCountText}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Grid.Row="0"
            Margin="24,24,24,12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="YouTube" />

        <GridView
            x:Name="VideosList"
            Grid.Row="1"
            Padding="12,0,12,12"
            IsItemClickEnabled="True"
            ItemClick="OnVideoClick"
            ItemTemplate="{StaticResource YouTubeFeedCardTemplate}"
            SelectionMode="None" />

        <ProgressRing
            Grid.Row="1"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
