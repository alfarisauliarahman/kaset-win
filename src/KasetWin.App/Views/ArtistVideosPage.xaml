<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ArtistVideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />

        <!-- 16:9 video card: thumbnail + title + "Artist • views" (classic Binding to avoid the XAML
             type generator trying to construct the required-member Song). -->
        <DataTemplate x:Key="VideoGridCardTemplate">
            <Grid Width="288" Padding="6">
                <StackPanel Spacing="6">
                    <Border
                        Width="276"
                        Height="155"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{Binding ListenerCountText}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasListenerCount, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{Binding ArtistsDisplay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasListenerCount, Converter={StaticResource InvertedBoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Circle card for related artists. -->
        <DataTemplate x:Key="ArtistCircleTemplate">
            <Grid Width="160" Padding="6">
                <StackPanel Spacing="6">
                    <Border
                        Width="148"
                        Height="148"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="74">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Opacity="0.65"
                        Text="{Binding SubtitleText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Square card for albums / playlists. -->
        <DataTemplate x:Key="SquareCardTemplate">
            <Grid Width="176" Padding="6">
                <StackPanel Spacing="6">
                    <Border
                        Width="164"
                        Height="164"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="{x:Bind Title, Mode=OneWay}"
            Style="{StaticResource TitleTextBlockStyle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GridView
                    x:Name="VideosGrid"
                    IsItemClickEnabled="True"
                    ItemClick="OnVideoClick"
                    ItemTemplate="{StaticResource VideoGridCardTemplate}"
                    SelectionMode="None" />
                <GridView
                    x:Name="CardsGrid"
                    IsItemClickEnabled="True"
                    ItemClick="OnCardClick"
                    ItemTemplate="{StaticResource SquareCardTemplate}"
                    SelectionMode="None" />
                <GridView
                    x:Name="ArtistsGrid"
                    IsItemClickEnabled="True"
                    ItemClick="OnArtistClick"
                    ItemTemplate="{StaticResource ArtistCircleTemplate}"
                    SelectionMode="None" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6"
            Text="Tidak ada data."
            Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource BodyTextBlockStyle}" />

        <ProgressRing
            Grid.Row="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind IsLoading, Mode=OneWay}" />
    </Grid>
</Page>
