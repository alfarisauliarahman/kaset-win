<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Lightweight Fluent "settings card": a rounded, subtly-filled container row. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="24"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!-- ── General ───────────────────────────────────────────── -->
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General" />

            <!-- Default launch page (Req 18.1) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Default launch page" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="The page Kaset opens to on launch."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LaunchPageComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.LaunchPages}"
                        SelectedItem="{x:Bind ViewModel.SelectedLaunchPage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LaunchPage">
                                <TextBlock Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Appearance: light/dark theme -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Tema" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Terang, gelap, atau ikuti tema Windows."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Language placeholder (Settings_Language / Req 19) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_Language" Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Follows the system language. Per-language override is coming in a later task."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        PlaceholderText="System default" />
                </Grid>
            </Border>

            <!-- ── Playback ──────────────────────────────────────────── -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Playback" />

            <!-- Preferred audio quality (Req 7.3) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Preferred audio quality" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Streaming quality Kaset requests when available."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AudioQualityComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.AudioQualities}"
                        SelectedItem="{x:Bind ViewModel.SelectedAudioQuality, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioQuality">
                                <TextBlock Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Remember playback settings (Req 18.2) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Remember playback settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Restore shuffle and repeat on next launch."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.RememberPlaybackSettings, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Lyrics ────────────────────────────────────────────── -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Lyrics" />

            <!-- Lyrics provider (source) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Sumber lirik" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Pilih penyedia lirik yang diutamakan. NetEase bagus untuk lagu Asia/K-pop."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.LyricsProviderOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLyricsProviderIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Synced lyrics enabled (Req 18.3) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Synced lyrics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Prefer time-synced lyrics, falling back to plain lyrics."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.SyncedLyricsEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Equalizer ─────────────────────────────────────────── -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Equalizer" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="Preset" />
                            <ComboBox
                                MinWidth="150"
                                ItemsSource="{x:Bind ViewModel.EqPresets}"
                                SelectedItem="{x:Bind ViewModel.SelectedEqPreset, Mode=TwoWay}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.IsEqualizerEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Top" Opacity="0.55">
                            <TextBlock Height="30" FontSize="11" Text="+12 dB" />
                            <TextBlock Height="30" FontSize="11" Text="+6 dB" />
                            <TextBlock Height="30" FontSize="11" Text="0 dB" />
                            <TextBlock Height="30" FontSize="11" Text="-6 dB" />
                            <TextBlock FontSize="11" Text="-12 dB" />
                        </StackPanel>

                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Width="52"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                        <Slider
                                            Height="150"
                                            HorizontalAlignment="Center"
                                            Maximum="12"
                                            Minimum="-12"
                                            Orientation="Vertical"
                                            StepFrequency="1"
                                            Value="{Binding Gain, Mode=TwoWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.7"
                                            Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <CheckBox
                        Content="Move nearby sliders together"
                        IsChecked="{x:Bind ViewModel.LinkNearbyBands, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ── Extensions / Adblock ──────────────────────────────── -->
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Extensions (Adblock)" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Opacity="0.8"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Kaset automatically downloads and updates uBlock Origin for the shared playback WebView profile. The folder below is still available for additional unpacked extensions; restart Kaset after changing custom extensions." />
                    <TextBlock
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind UBlockStatusText}" />
                    <TextBlock
                        Opacity="0.8"
                        Visibility="Collapsed"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Kaset loads unpacked browser extensions (like uBlock Origin) into its playback WebView — the Windows equivalent of the macOS user-managed extensions. Nothing is bundled: put each unpacked extension (a folder containing manifest.json) into the Extensions folder below, then restart Kaset. Extensions are loaded onto the shared browser profile, so their ad/network rules apply to YouTube Music and YouTube playback." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnOpenExtensionsFolder" Content="Open extensions folder" />
                        <Button Click="OnRestartApp" Content="Restart Kaset" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
