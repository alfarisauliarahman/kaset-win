<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Lightweight Fluent "settings card": a rounded, subtly-filled container row. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="24"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!-- Every label below is relabelled from UiStrings in ApplyLabels() (code-behind),
                 so the whole page follows the app language; the literals here are fallbacks. -->
            <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <!-- ── General ───────────────────────────────────────────── -->
            <TextBlock
                x:Name="GeneralHeader"
                Margin="0,4,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="General" />

            <!-- Default launch page (Req 18.1) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="LaunchPageLabel" Text="Default launch page" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="LaunchPageCaption"
                            Opacity="0.7"
                            Text="The page Kaset opens to on launch."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LaunchPageComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.LaunchPageOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLaunchPageIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Appearance: light/dark theme -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ThemeLabel" Text="Tema" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="ThemeCaption"
                            Opacity="0.7"
                            Text="Terang, gelap, atau ikuti tema Windows."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Content language (Settings_Language / Req 19): pins hl on every music request. -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="LanguageLabel" Text="Bahasa" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="LanguageCaption"
                            Opacity="0.7"
                            Text="Bahasa aplikasi dan konten YT Music (judul section, tanggal, deskripsi)."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                        SelectionChanged="OnLanguageSelectionChanged" />
                </Grid>
            </Border>

            <!-- Close behaviour: hide to tray (background audio) vs quit -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CloseBehaviorLabel" Text="Saat menutup jendela" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="CloseBehaviorCaption"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Text="Kecilkan ke tray membuat musik tetap berjalan di latar; Keluar menutup Kaset sepenuhnya."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.CloseBehaviorOptions}"
                        SelectedIndex="{x:Bind ViewModel.CloseBehaviorIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Playback ──────────────────────────────────────────── -->
            <TextBlock
                x:Name="PlaybackHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Playback" />

            <!-- Preferred audio quality (Req 7.3) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="AudioQualityLabel" Text="Preferred audio quality" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="AudioQualityCaption"
                            Opacity="0.7"
                            Text="Streaming quality Kaset requests when available."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AudioQualityComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.AudioQualityOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedAudioQualityIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Remember playback settings (Req 18.2) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="RememberLabel" Text="Remember playback settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="RememberCaption"
                            Opacity="0.7"
                            Text="Restore shuffle and repeat on next launch."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind ViewModel.RememberPlaybackSettings, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Global hotkeys (Req: system-wide playback control) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="HotkeysLabel" Text="Global hotkeys" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="HotkeysCaption"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Text="Control playback from any app: Ctrl+Alt+↓ play/pause, Ctrl+Alt+→ next, Ctrl+Alt+← previous, Ctrl+Alt+↑ mute. A combination already claimed by another app is skipped."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Global hotkeys"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind ViewModel.GlobalHotkeysEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Lyrics ────────────────────────────────────────────── -->
            <TextBlock
                x:Name="LyricsHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Lyrics" />

            <!-- Lyrics provider (source) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="LyricsSourceLabel" Text="Lyrics source" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="LyricsSourceCaption"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Text="Pick the preferred lyrics provider. YouTube Music is tried first because it matches by videoId; NetEase covers Asian/K-pop songs well."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            x:Name="LyricsSourceAttribution"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Text="YouTube Music's lyrics are the licensed label copy, credited per track to either LyricFind or Musixmatch — YouTube decides which one, not Kaset. Not every track comes with time-synced lines."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LyricsSourceCombo"
                        Grid.Column="1"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Lyrics source"
                        ItemsSource="{x:Bind ViewModel.LyricsProviderOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLyricsProviderIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Synced lyrics enabled (Req 18.3) -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="SyncedLabel" Text="Synced lyrics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="SyncedCaption"
                            Opacity="0.7"
                            Text="Prefer time-synced lyrics, falling back to plain lyrics."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind ViewModel.SyncedLyricsEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Equalizer ─────────────────────────────────────────── -->
            <TextBlock
                x:Name="EqualizerHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Equalizer" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="Preset" />
                            <ComboBox
                                MinWidth="150"
                                ItemsSource="{x:Bind ViewModel.EqPresets}"
                                SelectedItem="{x:Bind ViewModel.SelectedEqPreset, Mode=TwoWay}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.IsEqualizerEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- dB axis aligned to the slider THUMB travel, not the raw control height:
                             a 150px vertical Slider insets its thumb by ~10px top and bottom, so the
                             scale is 130px tall pushed down 10px (+12 at the top thumb, 0 mid, -12 at
                             the bottom thumb). -->
                        <Grid
                            Height="130"
                            Margin="0,10,4,0"
                            VerticalAlignment="Top"
                            Opacity="0.55">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Text="+12 dB" />
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Text="+6 dB" />
                            <TextBlock Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Text="0 dB" />
                            <TextBlock Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Text="-6 dB" />
                            <TextBlock Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Text="-12 dB" />
                        </Grid>

                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Width="52"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                        <!-- Nine identical sliders: without a per-band name a screen
                                             reader announces nine anonymous "-12 to 12" sliders and
                                             the frequency label below is unreachable from the thumb. -->
                                        <Slider
                                            Height="150"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="{Binding AccessibleName}"
                                            Maximum="12"
                                            Minimum="-12"
                                            Orientation="Vertical"
                                            StepFrequency="1"
                                            Value="{Binding Gain, Mode=TwoWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.7"
                                            Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <CheckBox
                        x:Name="EqLinkCheck"
                        Content="Move nearby sliders together"
                        IsChecked="{x:Bind ViewModel.LinkNearbyBands, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ── Extensions / Adblock ──────────────────────────────── -->
            <TextBlock
                x:Name="ExtensionsHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Extensions (Adblock)" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="ExtensionsCaption"
                        Opacity="0.8"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Kaset automatically downloads and updates uBlock Origin for the shared playback WebView profile. The folder below is still available for additional unpacked extensions; restart Kaset after changing custom extensions." />
                    <TextBlock
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind UBlockStatusText}" />
                    <TextBlock
                        Opacity="0.8"
                        Visibility="Collapsed"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Kaset loads unpacked browser extensions (like uBlock Origin) into its playback WebView — the Windows equivalent of the macOS user-managed extensions. Nothing is bundled: put each unpacked extension (a folder containing manifest.json) into the Extensions folder below, then restart Kaset. Extensions are loaded onto the shared browser profile, so their ad/network rules apply to YouTube Music and YouTube playback." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenExtFolderButton" Click="OnOpenExtensionsFolder" Content="Open extensions folder" />
                        <Button x:Name="RestartAppButton" Click="OnRestartApp" Content="Restart Kaset" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Discord Rich Presence ─────────────────────────────── -->
            <TextBlock
                x:Name="DiscordHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Discord" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="DiscordLabel" Text="Show on Discord" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="DiscordCaption"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Text="Show what you're listening to on your Discord profile. Off by default — this publishes your listening to anyone who can see your profile."
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.Name="Show on Discord"
                            VerticalAlignment="Center"
                            OnContent=""
                            OffContent=""
                            IsOn="{x:Bind ViewModel.DiscordRichPresenceEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- Advanced: almost nobody needs this. Only changes which application name
                         Discord displays; blank uses the id Kaset ships with. -->
                    <Expander
                        x:Name="DiscordAdvancedExpander"
                        HorizontalAlignment="Stretch"
                        Header="Advanced">
                        <StackPanel Spacing="10">
                            <TextBlock
                                x:Name="DiscordAdvancedCaption"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Text="Kaset uses its own Discord application. Set your own Application ID only if you want a different name to appear in &quot;Listening to …&quot;."
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBox
                                x:Name="DiscordAppIdBox"
                                AutomationProperties.Name="Discord Application ID"
                                PlaceholderText="Discord Application ID (optional)"
                                Text="{x:Bind ViewModel.DiscordApplicationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <HyperlinkButton
                                x:Name="DiscordPortalLink"
                                Content="Open the Discord Developer Portal"
                                NavigateUri="https://discord.com/developers/applications" />
                        </StackPanel>
                    </Expander>

                    <!-- Shown only while no id is available at all, so an inert toggle explains itself. -->
                    <InfoBar
                        x:Name="DiscordUnavailableBar"
                        IsClosable="False"
                        IsOpen="False"
                        Message="Discord rich presence isn't configured in this build. Set an Application ID under Advanced to use it."
                        Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- ── About ─────────────────────────────────────────────── -->
            <TextBlock
                x:Name="AboutHeader"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="VersionLabel" Text="App version" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionCaption" Opacity="0.7" Text="The running version of Kaset." Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" Text="" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
