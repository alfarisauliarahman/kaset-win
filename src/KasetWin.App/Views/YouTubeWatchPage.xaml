<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.YouTubeWatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left column: video surface + metadata + comments -->
        <ScrollViewer Grid.Column="0" Padding="24,16,16,16">
            <StackPanel Spacing="12">
                <!--
                    Video surface (Req 32.2). The dedicated YouTube watch WebView2 host is part of
                    the YouTube-mode foundation (IYouTubeWatchController); until it is attached,
                    playback is driven through the arbitrated YouTube video player and this region
                    shows the video thumbnail. The arbiter still guarantees a single audio source.
                -->
                <Border
                    Height="360"
                    Background="Black"
                    CornerRadius="12">
                    <Image
                        Source="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource UriToImageSource}}"
                        Stretch="Uniform" />
                </Border>

                <TextBlock
                    MaxLines="2"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        Opacity="0.7"
                        Text="{x:Bind ViewModel.ViewCountText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Opacity="0.7"
                        Text="{x:Bind ViewModel.PublishedText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- Channel + actions (Req 32.5) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.Channel.Name, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="{x:Bind ViewModel.Channel.SubscriberCountText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{x:Bind ViewModel.ToggleSubscribeCommand}" Content="Subscribe" />
                        <Button Command="{x:Bind ViewModel.LikeCommand}" Content="Like" />
                        <Button Command="{x:Bind ViewModel.DislikeCommand}" Content="Dislike" />
                        <Button Command="{x:Bind ViewModel.AddToWatchLaterCommand}" Content="Watch Later" />
                    </StackPanel>
                </Grid>

                <!-- Comments (Req 32.2) -->
                <TextBlock
                    Margin="0,12,0,0"
                    Text="Comments"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:YouTubeComment">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18">
                                    <Image
                                        Source="{x:Bind AuthorAvatarUrl, Converter={StaticResource UriToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind Author}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Opacity="0.6"
                                            Text="{x:Bind PublishedText}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Text}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Text="{x:Bind LikeCountText}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommentsCommand}"
                    Content="Load more comments"
                    Visibility="{x:Bind ViewModel.HasMoreComments, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Right column: related rail (Req 32.2) -->
        <ListView
            x:Name="RelatedList"
            Grid.Column="1"
            Padding="8,16,16,16"
            IsItemClickEnabled="True"
            ItemClick="OnRelatedClick"
            ItemsSource="{x:Bind ViewModel.Related, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:YouTubeVideo">
                    <Grid Padding="0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="120"
                            Height="68"
                            CornerRadius="6">
                            <Image
                                Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Opacity="0.7"
                                Text="{x:Bind ChannelName}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Grid.Column="0"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Column="0"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
