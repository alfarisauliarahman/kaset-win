<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KasetWin.App.Behaviors"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:kc="using:KasetWin.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <converters:DurationToTextConverter x:Key="DurationToText" />

        <!-- Album / single card (square art). -->
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="models:Album">
            <!--
                Grid root (not a Button): a Button must not contain the nested circular Play Button,
                because a Button-inside-a-Button breaks the outer control's hit-testing and the card
                click never reaches navigation. The Grid hit-tests via its Background, navigates on
                Tapped, is keyboard focusable (Enter/Space), and shows a subtle hover background; the
                Play Button is a sibling layered over the cover image.
            -->
            <Grid
                Width="168"
                Padding="8"
                Background="Transparent"
                CornerRadius="8"
                DataContext="{x:Bind}"
                IsTabStop="True"
                KeyDown="OnCardKeyDown"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                Tapped="OnAlbumCardClick"
                UseSystemFocusVisuals="True">
                <Border
                    x:Name="CardHover"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Opacity="0" />
                <StackPanel Spacing="8">
                    <Grid Width="152" Height="152" HorizontalAlignment="Center">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                        </Border>
                        <Button
                            x:Name="PlayOverlay"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnAlbumCardPlay"
                            CornerRadius="22"
                            GotFocus="OnPlayOverlayGotFocus"
                            IsHitTestVisible="False"
                            LostFocus="OnPlayOverlayLostFocus"
                            Opacity="0"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Play">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind Year}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Video card (wide 16:9 art). -->
        <DataTemplate x:Key="VideoCardTemplate" x:DataType="models:Song">
            <!-- Grid root (consistent with the other shelves): hit-tests via Background, navigates on Tapped, keyboard focusable. -->
            <Grid
                Width="248"
                Padding="8"
                Background="Transparent"
                CornerRadius="8"
                DataContext="{x:Bind}"
                IsTabStop="True"
                KeyDown="OnCardKeyDown"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                Tapped="OnVideoCardClick"
                UseSystemFocusVisuals="True">
                <Border
                    x:Name="CardHover"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Opacity="0" />
                <StackPanel Spacing="8">
                    <Border
                        Width="232"
                        Height="130"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- Prefer the "Artist • views" subtitle from YT Music; fall back to the artist name. -->
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ListenerCountText}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasListenerCount, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ArtistsDisplay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasListenerCount, Converter={StaticResource InvertedBoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Featured playlist card (square art). -->
        <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="models:Playlist">
            <!--
                Grid root (not a Button): the nested circular Play Button cannot live inside a Button
                root or hit-testing breaks. The Grid hit-tests via Background, navigates on Tapped, is
                keyboard focusable, and shows a hover background; the Play Button is a sibling.
            -->
            <Grid
                Width="168"
                Padding="8"
                Background="Transparent"
                CornerRadius="8"
                DataContext="{x:Bind}"
                IsTabStop="True"
                KeyDown="OnCardKeyDown"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                Tapped="OnPlaylistCardClick"
                UseSystemFocusVisuals="True">
                <Border
                    x:Name="CardHover"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Opacity="0" />
                <StackPanel Spacing="8">
                    <Grid Width="152" Height="152" HorizontalAlignment="Center">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                        </Border>
                        <Button
                            x:Name="PlayOverlay"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="OnPlaylistCardPlay"
                            CornerRadius="22"
                            GotFocus="OnPlayOverlayGotFocus"
                            IsHitTestVisible="False"
                            LostFocus="OnPlayOverlayLostFocus"
                            Opacity="0"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Play">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Related artist card (circular art). -->
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="models:Artist">
            <!-- Grid root (consistent with the other shelves): hit-tests via Background, navigates on Tapped, keyboard focusable. -->
            <Grid
                Width="152"
                Padding="8"
                Background="Transparent"
                CornerRadius="8"
                DataContext="{x:Bind}"
                IsTabStop="True"
                KeyDown="OnCardKeyDown"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
                Tapped="OnArtistCardClick"
                UseSystemFocusVisuals="True">
                <Border
                    x:Name="CardHover"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Opacity="0" />
                <StackPanel Spacing="8">
                    <Border
                        Width="136"
                        Height="136"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="68">
                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="2"
                        Text="{x:Bind Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Opacity="0.65"
                        Text="{x:Bind SubtitleText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasSubtitle, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="24">

                <!-- Header banner: cover image with a gradient scrim and name/meta overlaid (Req 15.1).
                     Height tracks the width at the YT-Music banner ratio (1920×800 ≈ 2.4:1) so the
                     art fills the width without being cropped (see OnBannerSizeChanged). -->
                <Grid
                    x:Name="HeaderBanner"
                    Height="320"
                    SizeChanged="OnBannerSizeChanged">
                    <Image
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Source="{x:Bind ViewModel.HeaderImageUrl, Converter={StaticResource UriToImageSource}, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.HasHeaderImage, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                    <!-- Legibility scrim: transparent at the top, dark at the bottom. -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Offset="0.0" Color="#00000000" />
                                <GradientStop Offset="0.55" Color="#66000000" />
                                <GradientStop Offset="1.0" Color="#D9000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel
                        Margin="24,0,24,20"
                        VerticalAlignment="Bottom"
                        Spacing="6">
                        <TextBlock
                            FontSize="44"
                            FontWeight="Bold"
                            Foreground="White"
                            MaxLines="2"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="White"
                            Opacity="0.85"
                            Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasMetaLine, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="24,0,24,0" Spacing="20">

                    <!-- Action buttons: Shuffle, Radio, Subscribe (Req 15.3, 15.4) -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Command="{x:Bind ViewModel.ShuffleTopSongsCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasTopSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B1;" />
                                <TextBlock Text="Acak" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.PlayTopSongsCommand}"
                            Visibility="{x:Bind ViewModel.HasTopSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                <TextBlock Text="Putar" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.StartRadioCommand}"
                            Visibility="{x:Bind ViewModel.HasRadio, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE93E;" />
                                <TextBlock Text="Radio" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ToggleSubscribeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.SubscribeGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SubscribeLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <!-- Description with Show more / Show less expander (Req 15.1) -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.HasDescription, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <TextBlock
                            x:Name="DescriptionText"
                            IsTextTrimmedChanged="OnDescriptionTrimmedChanged"
                            MaxLines="{x:Bind ViewModel.DescriptionMaxLines, Mode=OneWay}"
                            Opacity="0.8"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <HyperlinkButton
                            Command="{x:Bind ViewModel.ToggleDescriptionCommand}"
                            Content="{x:Bind ViewModel.DescriptionToggleLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanExpandDescription, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Top songs (Req 15.1, 15.4) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasTopSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Lagu teratas" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllSongsClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <!-- Column-major grid: fills 5 rows down a column, then wraps to the next
                             column and scrolls horizontally (Apple-Music style). GridView gives
                             reliable click-to-play (ItemClick) and native keyboarding. -->
                        <GridView
                            Height="290"
                            IsItemClickEnabled="True"
                            ItemClick="OnSongClick"
                            ItemsSource="{x:Bind ViewModel.TopSongs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:Song">
                                    <Grid
                                        Width="430"
                                        Padding="8,6"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <kc:TrackInfo Grid.Column="1" Song="{x:Bind}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Opacity="0.62"
                                            Text="{x:Bind ListenerCountText}"
                                            Visibility="{x:Bind HasListenerCount, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Opacity="0.7"
                                            Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- Albums (Req 15.1, 15.2) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasAlbums, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Album" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllAlbumsClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllAlbums, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource AlbumCardTemplate}" ItemsSource="{x:Bind ViewModel.Albums}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Singles & EPs (Req 15.1, 15.2) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasSingles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Single &amp; EP" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllSinglesClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllSingles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource AlbumCardTemplate}" ItemsSource="{x:Bind ViewModel.SinglesAndEps}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Videos (Req 15.1) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasVideos, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Video" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllVideosClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllVideos, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource VideoCardTemplate}" ItemsSource="{x:Bind ViewModel.Videos}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Live performances (separate video shelf) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasLive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Pertunjukan langsung" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllLiveClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllLive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource VideoCardTemplate}" ItemsSource="{x:Bind ViewModel.LivePerformances}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Featured on / playlists (Req 15.1) -->
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasFeatured, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Tampil di" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllFeaturedClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllFeatured, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource PlaylistCardTemplate}" ItemsSource="{x:Bind ViewModel.FeaturedPlaylists}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Fans might also like / related artists (Req 15.1) -->
                    <StackPanel
                        Margin="0,0,0,24"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasRelated, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Penggemar mungkin juga suka" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Click="OnSeeAllRelatedClick"
                                Content="Lihat semua"
                                Visibility="{x:Bind ViewModel.CanSeeAllRelated, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                        <ScrollViewer
                            behaviors:VerticalWheelForwarder.IsEnabled="True"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <controls:ItemsRepeater ItemTemplate="{StaticResource ArtistCardTemplate}" ItemsSource="{x:Bind ViewModel.RelatedArtists}">
                                <controls:ItemsRepeater.Layout>
                                    <controls:StackLayout Orientation="Horizontal" Spacing="12" />
                                </controls:ItemsRepeater.Layout>
                            </controls:ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading affordance (Req 16.x) -->
        <ProgressRing
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</Page>
