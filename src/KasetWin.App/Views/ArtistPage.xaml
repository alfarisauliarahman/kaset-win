<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="24,16,24,24">
            <StackPanel Spacing="24">

                <!-- Header: thumbnail + name/description + actions (Req 15.1, 15.3, 15.4) -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="160"
                        Height="160"
                        VerticalAlignment="Top"
                        CornerRadius="80">
                        <Image
                            Source="{x:Bind ViewModel.ThumbnailUrl, Converter={StaticResource UriToImageSource}, Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="12">
                        <TextBlock
                            MaxLines="2"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock
                            MaxLines="4"
                            Opacity="0.75"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasDescription, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.PlayTopSongsCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasTopSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ToggleSubscribeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.SubscribeGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SubscribeLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Top songs (Req 15.1, 15.4) -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasTopSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="Top songs" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnSeeAllSongsClick"
                            Content="See all"
                            Visibility="{x:Bind ViewModel.CanSeeAllSongs, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnSongClick"
                        ItemsSource="{x:Bind ViewModel.TopSongs}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Song">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="4">
                                        <Image
                                            Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind ArtistsDisplay}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Albums (Req 15.1, 15.2) -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasAlbums, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="Albums" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnSeeAllAlbumsClick"
                            Content="See all"
                            Visibility="{x:Bind ViewModel.CanSeeAllAlbums, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemsSource="{x:Bind ViewModel.Albums}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <StackPanel Width="160" Margin="0,0,8,8" Spacing="6">
                                    <Border Width="160" Height="160" CornerRadius="6">
                                        <Image
                                            Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        MaxLines="2"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        MaxLines="1"
                                        Opacity="0.7"
                                        Text="{x:Bind Year}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Singles & EPs (Req 15.1, 15.2) -->
                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasSingles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="Singles &amp; EPs" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="OnSeeAllSinglesClick"
                            Content="See all"
                            Visibility="{x:Bind ViewModel.CanSeeAllSingles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemsSource="{x:Bind ViewModel.SinglesAndEps}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <StackPanel Width="160" Margin="0,0,8,8" Spacing="6">
                                    <Border Width="160" Height="160" CornerRadius="6">
                                        <Image
                                            Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        MaxLines="2"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        MaxLines="1"
                                        Opacity="0.7"
                                        Text="{x:Bind Year}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading affordance (Req 16.x) -->
        <ProgressRing
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</Page>
