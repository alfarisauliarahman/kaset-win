<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.PodcastsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A single horizontal "shelf" of cards for one podcast section. -->
        <DataTemplate x:Key="PodcastSectionTemplate" x:DataType="vm:PodcastSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PodcastCardItem">
                                <Button
                                    Width="168"
                                    Padding="8"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnItemClick"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnSubscribe" Text="Subscribe" />
                                            <MenuFlyoutItem Click="OnUnsubscribe" Text="Unsubscribe" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="152"
                                            Height="152"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <Image
                                                Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <!-- Apple-Podcasts-style progress bar (episodes with progress only). -->
                                        <ProgressBar
                                            Maximum="1"
                                            Value="{x:Bind Progress}"
                                            Visibility="{x:Bind HasProgress, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Podcasts" />

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource PodcastSectionTemplate}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <!-- Available region with no content yet. -->
                <TextBlock
                    Opacity="0.7"
                    Text="No podcasts to show right now."
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
