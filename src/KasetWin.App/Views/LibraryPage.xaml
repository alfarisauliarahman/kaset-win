<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:core="using:KasetWin.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:LibraryFilterToStyleConverter x:Key="FilterStyle" />
        <converters:DurationToTextConverter x:Key="DurationToText" />

        <!-- Uniform card containers: zero out GridViewItem's default min sizes/margins so no cell
             can render larger than its siblings. -->
        <Style x:Key="LibraryCardContainer" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,4,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!-- Row in the "Save to playlist" picker: cover + title. -->
        <DataTemplate x:Key="PlaylistPickerItemTemplate" x:DataType="core:Playlist">
            <Grid Padding="0,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="64"
                    Height="64"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="2"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + create playlist (Req 13.2) -->
        <StackPanel
            Grid.Row="0"
            Padding="24,24,24,8"
            Spacing="12">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Library" />

            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBox
                    x:Name="NewPlaylistBox"
                    Width="280"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Bind loc:UiStrings.LibraryNewPlaylistPlaceholder}"
                    Text="{Binding NewPlaylistTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    VerticalAlignment="Center"
                    Command="{Binding CreatePlaylistCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind loc:UiStrings.LibraryCreatePlaylist}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Error / loading affordances (collapsed when idle so they don't leave a gap) -->
            <ProgressRing
                HorizontalAlignment="Left"
                IsActive="{Binding IsLoading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
        </StackPanel>

        <!-- Filter chips (Req 13.5) -->
        <StackPanel
            Grid.Row="1"
            Padding="24,0,24,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{Binding SetFilterCommand}"
                CommandParameter="All"
                Content="{x:Bind loc:UiStrings.FilterAll}"
                Style="{Binding SelectedFilter, Converter={StaticResource FilterStyle}, ConverterParameter=All}" />
            <Button
                Command="{Binding SetFilterCommand}"
                CommandParameter="Playlists"
                Content="{x:Bind loc:UiStrings.LibraryPlaylists}"
                Style="{Binding SelectedFilter, Converter={StaticResource FilterStyle}, ConverterParameter=Playlists}" />
            <Button
                Command="{Binding SetFilterCommand}"
                CommandParameter="Songs"
                Content="{x:Bind loc:UiStrings.LibrarySongs}"
                Style="{Binding SelectedFilter, Converter={StaticResource FilterStyle}, ConverterParameter=Songs}" />
            <Button
                Command="{Binding SetFilterCommand}"
                CommandParameter="Artists"
                Content="{x:Bind loc:UiStrings.LibraryArtists}"
                Style="{Binding SelectedFilter, Converter={StaticResource FilterStyle}, ConverterParameter=Artists}" />
            <Button
                Command="{Binding SetFilterCommand}"
                CommandParameter="Albums"
                Content="{x:Bind loc:UiStrings.LibraryAlbums}"
                Style="{Binding SelectedFilter, Converter={StaticResource FilterStyle}, ConverterParameter=Albums}" />
        </StackPanel>

        <ScrollViewer x:Name="LibraryScroller" Grid.Row="2" Padding="24,0,24,24">
            <StackPanel Spacing="8">

                <!-- Playlists -->
                <StackPanel Spacing="8" Visibility="{Binding ShowPlaylists, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LibPlaylistsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Playlists" />
                    <GridView
                        x:Name="PlaylistsGrid"
                        IsItemClickEnabled="True"
                        ItemClick="OnPlaylistClick"
                        ItemsSource="{Binding Playlists}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.IsHorizontalRailEnabled="False"
                        ItemContainerStyle="{StaticResource LibraryCardContainer}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Explicit cell size: ItemsWrapGrid otherwise sizes every cell to
                                     the first realized item, which made one card render oversized. -->
                                <ItemsWrapGrid ItemWidth="172" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:Playlist">
                                <Grid Width="160" Padding="6">
                                    <StackPanel Spacing="2">
                                        <Grid Margin="0,0,0,4">
                                            <Border
                                                Width="148"
                                                Height="148"
                                                CornerRadius="8">
                                                <Image Width="148" Height="148" Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                            </Border>
                                            <!-- Delete affordance only for owned playlists (Req 13.4 / 14.3) -->
                                            <Button
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeletePlaylistCommand, ElementName=NewPlaylistBox}"
                                                CommandParameter="{x:Bind}"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                AutomationProperties.Name="{x:Bind loc:UiStrings.MenuDeletePlaylist}"
                                                ToolTipService.ToolTip="{x:Bind loc:UiStrings.MenuDeletePlaylist}"
                                                Visibility="{x:Bind IsOwnedByUser, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            MaxLines="2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="13"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding TrackCount}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Songs (library saved songs) — columnar: title · artist · album · duration -->
                <StackPanel Spacing="8" Visibility="{Binding ShowSongs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LibSongsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Songs" />
                    <ListView x:Name="LikedList" ItemsSource="{Binding LibrarySongs}" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Song">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="4">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        Opacity="0.75"
                                        Text="{x:Bind ArtistsDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        Opacity="0.6"
                                        Text="{x:Bind Album.Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="4"
                                        MinWidth="42"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        HorizontalTextAlignment="Right"
                                        Opacity="0.6"
                                        Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Command="{Binding DataContext.PlaySongCommand, ElementName=NewPlaylistBox}"
                                            CommandParameter="{x:Bind}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            AutomationProperties.Name="{x:Bind loc:UiStrings.PlayLabel}"
                                            ToolTipService.ToolTip="{x:Bind loc:UiStrings.PlayLabel}">
                                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            Click="OnAddLibrarySongToPlaylist"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind loc:UiStrings.MenuSaveToPlaylist}"
                                            ToolTipService.ToolTip="{x:Bind loc:UiStrings.MenuSaveToPlaylist}">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Uploaded songs -->
                <StackPanel Spacing="8" Visibility="{Binding ShowSongs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LibUploadsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Uploads" />
                    <ListView x:Name="UploadsList" ItemsSource="{Binding UploadedSongs}" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Song">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtistsDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.PlaySongCommand, ElementName=NewPlaylistBox}"
                                        CommandParameter="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        AutomationProperties.Name="{x:Bind loc:UiStrings.PlayLabel}"
                                        ToolTipService.ToolTip="{x:Bind loc:UiStrings.PlayLabel}">
                                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Followed artists -->
                <StackPanel Spacing="8" Visibility="{Binding ShowArtists, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LibArtistsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Artists" />
                    <GridView
                        x:Name="ArtistsGrid"
                        IsItemClickEnabled="True"
                        ItemClick="OnArtistClick"
                        ItemsSource="{Binding Artists}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.IsHorizontalRailEnabled="False"
                        ItemContainerStyle="{StaticResource LibraryCardContainer}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid ItemWidth="162" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:Artist">
                                <Grid Width="150" Padding="6">
                                    <StackPanel Spacing="2">
                                        <Border
                                            Width="138"
                                            Height="138"
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Center"
                                            CornerRadius="69">
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            MaxLines="2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <!-- "N lagu" from the saved-songs corpus. -->
                                        <TextBlock
                                            FontSize="13"
                                            HorizontalAlignment="Center"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind SubtitleText}"
                                            TextAlignment="Center"
                                            Visibility="{x:Bind HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Albums -->
                <StackPanel Spacing="8" Visibility="{Binding ShowAlbums, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="LibAlbumsHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Albums" />
                    <GridView
                        x:Name="AlbumsGrid"
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemsSource="{Binding Albums}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.IsHorizontalRailEnabled="False"
                        ItemContainerStyle="{StaticResource LibraryCardContainer}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid ItemWidth="172" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:Album">
                                <Grid Width="160" Padding="6">
                                    <StackPanel Spacing="2">
                                        <Border
                                            Width="148"
                                            Height="148"
                                            Margin="0,0,0,4"
                                            CornerRadius="8">
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            FontSize="15"
                                            MaxLines="2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="13"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtistsDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
