<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:core="using:KasetWin.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + create playlist (Req 13.2) -->
        <StackPanel
            Grid.Row="0"
            Padding="24,24,24,8"
            Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="NewPlaylistBox"
                    Width="280"
                    PlaceholderText="New playlist title"
                    Text="{Binding NewPlaylistTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Command="{Binding CreatePlaylistCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Create playlist" />
                    </StackPanel>
                </Button>
                <ComboBox
                    Width="220"
                    DisplayMemberPath="Title"
                    Header="Add songs to"
                    ItemsSource="{Binding Playlists}"
                    PlaceholderText="Select a playlist"
                    SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" />
            </StackPanel>

            <!-- Error / loading affordances -->
            <ProgressRing IsActive="{Binding IsLoading}" HorizontalAlignment="Left" />
            <InfoBar
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
        </StackPanel>

        <!-- Filter chips (Req 13.5) -->
        <StackPanel
            Grid.Row="1"
            Padding="24,0,24,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding SetFilterCommand}" CommandParameter="All" Content="All" />
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Playlists" Content="Playlists" />
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Songs" Content="Songs" />
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Artists" Content="Artists" />
            <Button Command="{Binding SetFilterCommand}" CommandParameter="Albums" Content="Albums" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="24,0,24,24">
            <StackPanel Spacing="20">

                <!-- Playlists -->
                <StackPanel Spacing="8" Visibility="{Binding ShowPlaylists, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Playlists" />
                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnPlaylistClick"
                        ItemsSource="{Binding Playlists}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Playlist">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="4">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding TrackCount}" />
                                    </StackPanel>
                                    <!-- Delete affordance only for owned playlists (Req 13.4 / 14.3) -->
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeletePlaylistCommand, ElementName=NewPlaylistBox}"
                                        CommandParameter="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Delete playlist"
                                        Visibility="{x:Bind IsOwnedByUser, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Liked songs -->
                <StackPanel Spacing="8" Visibility="{Binding ShowSongs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Liked songs" />
                    <ListView ItemsSource="{Binding LikedSongs}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Song">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="4">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtistsDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Command="{Binding DataContext.PlaySongCommand, ElementName=NewPlaylistBox}"
                                            CommandParameter="{x:Bind}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Play">
                                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            Command="{Binding DataContext.AddSongToPlaylistCommand, ElementName=NewPlaylistBox}"
                                            CommandParameter="{x:Bind}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Add to selected playlist">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Uploaded songs -->
                <StackPanel Spacing="8" Visibility="{Binding ShowSongs, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Uploads" />
                    <ListView ItemsSource="{Binding UploadedSongs}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Song">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtistsDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.PlaySongCommand, ElementName=NewPlaylistBox}"
                                        CommandParameter="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Play">
                                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Followed artists -->
                <StackPanel Spacing="8" Visibility="{Binding ShowArtists, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Artists" />
                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnArtistClick"
                        ItemsSource="{Binding Artists}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Artist">
                                <StackPanel Orientation="Horizontal" Padding="0,6" Spacing="12">
                                    <Border
                                        Width="48"
                                        Height="48"
                                        CornerRadius="24">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Albums -->
                <StackPanel Spacing="8" Visibility="{Binding ShowAlbums, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Albums" />
                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemsSource="{Binding Albums}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Album">
                                <StackPanel Orientation="Horizontal" Padding="0,6" Spacing="12">
                                    <Border
                                        Width="48"
                                        Height="48"
                                        CornerRadius="4">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtistsDisplay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
