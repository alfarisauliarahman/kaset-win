<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:ActiveLineToFontWeightConverter x:Key="ActiveLineToFontWeight" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: track + LIVE badge + provider + loading -->
        <StackPanel
            Grid.Row="0"
            Padding="24,24,24,12"
            Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton
                    Click="OnTitleClick"
                    Style="{StaticResource InlineLinkButtonStyle}"
                    ToolTipService.ToolTip="Go to album"
                    Visibility="{x:Bind ViewModel.HasAlbumLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{ThemeResource HyperlinkButtonForeground}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource TitleTextBlockStyle}" />
                </HyperlinkButton>
                <TextBlock
                    MaxLines="1"
                    Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.TitleIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <Border
                    VerticalAlignment="Center"
                    Padding="8,2"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.IsLive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="LIVE"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>

            <HyperlinkButton
                Click="OnArtistClick"
                Style="{StaticResource InlineLinkButtonStyle}"
                ToolTipService.ToolTip="Go to artist"
                Visibility="{x:Bind ViewModel.HasArtistLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Foreground="{ThemeResource HyperlinkButtonForeground}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock
                MaxLines="1"
                Opacity="0.8"
                Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.ArtistIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoadingLyrics, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingLyrics, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.ActiveProvider, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Synced lyrics: highlight the current line (Req 17.2) -->
        <ListView
            x:Name="LyricsList"
            Grid.Row="1"
            Padding="24,8,24,24"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowSynced, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LyricLineItem">
                    <TextBlock
                        Margin="0,4"
                        FontWeight="{x:Bind IsActive, Converter={StaticResource ActiveLineToFontWeight}, Mode=OneWay}"
                        Opacity="{x:Bind IsActive, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Plain lyrics fallback (Req 17.3) -->
        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,24"
            Visibility="{x:Bind ViewModel.ShowPlain, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <TextBlock
                Text="{x:Bind ViewModel.PlainText, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource BodyTextBlockStyle}" />
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6"
            Text="No lyrics available for this track."
            Visibility="{x:Bind ViewModel.ShowEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
            Style="{StaticResource BodyTextBlockStyle}" />
    </Grid>
</Page>
