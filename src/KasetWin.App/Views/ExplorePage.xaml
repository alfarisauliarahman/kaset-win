<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KasetWin.App.Behaviors"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:views="using:KasetWin.App.Views"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Trending / chart section: title + "Selengkapnya", then a numbered column-major grid
             (down-then-across, 4 rows per column) matching YouTube Music's Trending layout. -->
        <DataTemplate x:Key="ChartSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <Grid>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="OnChartSeeAllClick"
                        Content="{x:Bind loc:UiStrings.MoreLabel}"
                        Tag="{x:Bind}" />
                </Grid>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout
                                MaximumRowsOrColumns="4"
                                MinColumnSpacing="8"
                                MinRowSpacing="4"
                                Orientation="Vertical" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Grid
                                    Width="380"
                                    Height="68"
                                    Padding="6"
                                    Background="Transparent"
                                    ColumnSpacing="12"
                                    ContextRequested="OnCardContextRequested"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    PointerEntered="OnChartCardEnter"
                                    PointerExited="OnChartCardExit"
                                    Tapped="OnItemClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.7"
                                        Text="{x:Bind RankText}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Grid.Column="1" Width="52" Height="52" VerticalAlignment="Center" CornerRadius="4">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Top artists chart ("Artis teratas"): numbered, column-major list (4 rows per column,
             down-then-across) with a circular photo, a coloured movement arrow, the rank number and
             the subscriber count — matching YouTube Music's chart layout. -->
        <DataTemplate x:Key="ArtistChartSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <Grid>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="OnChartSeeAllClick"
                        Content="{x:Bind loc:UiStrings.MoreLabel}"
                        Tag="{x:Bind}" />
                </Grid>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout
                                MaximumRowsOrColumns="4"
                                MinColumnSpacing="24"
                                MinRowSpacing="6"
                                Orientation="Vertical" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Grid
                                    Width="440"
                                    Height="64"
                                    Padding="6,4"
                                    Background="Transparent"
                                    ColumnSpacing="10"
                                    ContextRequested="OnCardContextRequested"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    PointerEntered="OnChartCardEnter"
                                    PointerExited="OnChartCardExit"
                                    Tapped="OnItemClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        VerticalAlignment="Center"
                                        CornerRadius="24">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <FontIcon
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{x:Bind TrendBrush}"
                                        Glyph="{x:Bind TrendGlyph}"
                                        Visibility="{x:Bind HasTrend, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind RankText}" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- New music videos: wide 16:9 cards (title + artist), with a "Lihat semua" list. -->
        <DataTemplate x:Key="VideoSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <Grid>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button HorizontalAlignment="Right" Click="OnChartSeeAllClick" Content="{x:Bind loc:UiStrings.SeeAll}" Tag="{x:Bind}" />
                </Grid>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Grid
                                    Width="256"
                                    Padding="8"
                                    Background="Transparent"
                                    ContextRequested="OnCardContextRequested"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick">
                                    <!-- Same ListViewItem-like hover affordance as the shelf cards
                                         (CardHover toggled by CardPlayOverlay). -->
                                    <Border
                                        x:Name="CardHover"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                    <StackPanel Spacing="2">
                                        <Border
                                            Width="240"
                                            Height="135"
                                            Margin="0,0,0,4"
                                            CornerRadius="8">
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            FontSize="15"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            FontSize="13"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- A single horizontal "shelf" of cards for one section. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <!--
                                    Grid root (not a Button): a Button must not contain the nested
                                    circular Play Button, since a Button-inside-a-Button breaks the
                                    outer control's hit-testing and the card click never reaches
                                    FeedNavigation.Activate. The Grid hit-tests via its Background,
                                    navigates on Tapped, is keyboard focusable (Enter/Space), and
                                    shows a subtle hover background; the Play Button is a sibling
                                    layered over the cover image.
                                -->
                                <Grid
                                    Width="{x:Bind CardWidth}"
                                    Padding="8"
                                    Background="Transparent"
                                    ContextRequested="OnCardContextRequested"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick"
                                    UseSystemFocusVisuals="True">
                                    <Border
                                        x:Name="CardHover"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                    <StackPanel Spacing="2">
                                        <Grid
                                            Width="{x:Bind TileWidth}"
                                            Height="{x:Bind TileHeight}"
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{x:Bind ImageCornerRadius}">
                                                <Image
                                                    Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <Button
                                                x:Name="PlayOverlay"
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="OnCardPlay"
                                                CornerRadius="22"
                                                GotFocus="OnPlayOverlayGotFocus"
                                                IsHitTestVisible="False"
                                                LostFocus="OnPlayOverlayLostFocus"
                                                Opacity="0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="{x:Bind loc:UiStrings.PlayLabel}"
                                                ToolTipService.ToolTip="{x:Bind loc:UiStrings.PlayLabel}"
                                                Visibility="{x:Bind CanPlay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            FontSize="13"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Moods & genres ("Jenis musik & suasana"): YT Music-style chip grid — full-colour cards
             (#193: the whole chip is painted with its category colour, label in per-chip
             contrasting text via ChipTextBrush), 4 rows flowing column-major behind a horizontal
             scroll, plus "Selengkapnya". The see-all deliberately browses the FULL category list
             (FEmusic_moods_and_genres) instead of re-showing this same shelf's payload. -->
        <DataTemplate x:Key="MoodSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <Grid>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="OnMoodsSeeAllClick"
                        Content="{x:Bind loc:UiStrings.MoreLabel}" />
                </Grid>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout
                                MaximumRowsOrColumns="4"
                                MinColumnSpacing="8"
                                MinRowSpacing="8"
                                Orientation="Vertical" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Grid
                                    Width="220"
                                    Height="48"
                                    Background="{x:Bind ChipBrush}"
                                    CornerRadius="6"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick"
                                    UseSystemFocusVisuals="True">
                                    <!-- Hover = 8% black scrim over the full-colour chip (CardHover
                                         toggled by CardPlayOverlay; a background swap cannot work
                                         here because the chip owns its category colour). The text
                                         carries the side padding so the scrim covers the whole chip. -->
                                    <Border
                                        x:Name="CardHover"
                                        Background="#14000000"
                                        CornerRadius="6"
                                        Opacity="0" />
                                    <TextBlock
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind ChipTextBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Chooses the chart grid for Trending/chart sections, the chip grid for moods,
             the shelf for everything else. -->
        <views:HomeSectionTemplateSelector
            x:Key="SectionTemplateSelector"
            ArtistChartTemplate="{StaticResource ArtistChartSectionTemplate}"
            ChartTemplate="{StaticResource ChartSectionTemplate}"
            MoodTemplate="{StaticResource MoodSectionTemplate}"
            ShelfTemplate="{StaticResource SectionTemplate}"
            VideoTemplate="{StaticResource VideoSectionTemplate}" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Explore" />

                <!-- Entry points to the reusable Explore detail surface (Req 31.1/31.2). -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_new_releases">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE7C3;" />
                            <TextBlock x:Name="NewReleasesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="New Releases" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_charts">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE9D9;" />
                            <TextBlock x:Name="ChartsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Charts" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_moods_and_genres">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE8EC;" />
                            <TextBlock x:Name="MoodsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Moods &amp; Genres" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource SectionTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <Button
                    x:Name="LoadMoreButton"
                    HorizontalAlignment="Center"
                    Click="OnLoadMoreClick"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
