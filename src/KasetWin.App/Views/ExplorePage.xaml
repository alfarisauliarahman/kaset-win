<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KasetWin.App.Behaviors"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A single horizontal "shelf" of cards for one section. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <!--
                                    Grid root (not a Button): a Button must not contain the nested
                                    circular Play Button, since a Button-inside-a-Button breaks the
                                    outer control's hit-testing and the card click never reaches
                                    FeedNavigation.Activate. The Grid hit-tests via its Background,
                                    navigates on Tapped, is keyboard focusable (Enter/Space), and
                                    shows a subtle hover background; the Play Button is a sibling
                                    layered over the cover image.
                                -->
                                <Grid
                                    Width="168"
                                    Padding="8"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick"
                                    UseSystemFocusVisuals="True">
                                    <Border
                                        x:Name="CardHover"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                    <StackPanel Spacing="8">
                                        <Grid Width="152" Height="152" HorizontalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{x:Bind ImageCornerRadius}">
                                                <Image
                                                    Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <Button
                                                x:Name="PlayOverlay"
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="OnCardPlay"
                                                CornerRadius="22"
                                                GotFocus="OnPlayOverlayGotFocus"
                                                IsHitTestVisible="False"
                                                LostFocus="OnPlayOverlayLostFocus"
                                                Opacity="0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play"
                                                Visibility="{x:Bind CanPlay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Explore" />

                <!-- Entry points to the reusable Explore detail surface (Req 31.1/31.2). -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_new_releases">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE7C3;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="New Releases" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_charts">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE9D9;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Charts" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="160"
                        Padding="16,12"
                        Click="OnEntryPointClick"
                        CornerRadius="8"
                        Tag="FEmusic_moods_and_genres">
                        <StackPanel Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE8EC;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Moods &amp; Genres" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource SectionTemplate}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <Button
                    HorizontalAlignment="Center"
                    Click="OnLoadMoreClick"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
