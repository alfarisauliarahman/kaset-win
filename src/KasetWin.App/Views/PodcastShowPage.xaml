<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.PodcastShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:DurationToTextConverter x:Key="DurationToText" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: cover + title + author -->
        <Grid Grid.Row="0" Margin="24,24,24,12" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="140"
                Height="140"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="10">
                <Image Source="{x:Bind ViewModel.ThumbnailUrl, Mode=OneWay, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="6">
                <TextBlock
                    MaxLines="3"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <!-- Creator line: round avatar (when the header carries one) + clickable name. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="14"
                        Visibility="{x:Bind ViewModel.HasAuthorThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{x:Bind ViewModel.AuthorThumbnailUrl, Mode=OneWay, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="OnAuthorClick"
                        Content="{x:Bind ViewModel.Author, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    MaxLines="2"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock
                    Opacity="0.55"
                    Text="{x:Bind ViewModel.EpisodeCountText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnSaveShowClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8A4;" />
                            <TextBlock Text="{x:Bind ViewModel.SaveLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnShareShowClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72D;" />
                            <TextBlock Text="{x:Bind loc:UiStrings.MenuShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar: find-in-show + sort -->
        <StackPanel
            Grid.Row="1"
            Margin="24,0,24,8"
            Orientation="Horizontal"
            Spacing="10">
            <TextBox
                x:Name="FindBox"
                Width="280"
                PlaceholderText="{x:Bind loc:UiStrings.PodcastFindInShow}"
                TextChanged="OnFindTextChanged" />
            <ComboBox MinWidth="130" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Bind loc:UiStrings.PodcastSortNewest}" />
                <ComboBoxItem Content="{x:Bind loc:UiStrings.PodcastSortOldest}" />
            </ComboBox>
            <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.PlayedFilterIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Bind loc:UiStrings.FilterAll}" />
                <ComboBoxItem Content="{x:Bind loc:UiStrings.PodcastFilterUnplayed}" />
                <ComboBoxItem Content="{x:Bind loc:UiStrings.PodcastFilterPlayed}" />
                <ComboBoxItem Content="{x:Bind loc:UiStrings.PodcastFilterUnfinished}" />
            </ComboBox>
        </StackPanel>

        <!-- Episodes -->
        <ListView
            x:Name="EpisodesList"
            Grid.Row="2"
            Padding="12,0,12,12"
            IsItemClickEnabled="True"
            ItemClick="OnEpisodeClick"
            ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PodcastEpisode">
                    <!-- Background=Transparent: without it the row's empty space is not hit-testable,
                         so right-click only worked directly over text/thumbnail. -->
                    <Grid
                        Padding="8,10"
                        Background="Transparent"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnSaveForLaterClick" Text="{x:Bind loc:UiStrings.MenuQueueForLater}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECC8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnPlayNextClick" Text="{x:Bind loc:UiStrings.MenuPlayNext}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B0;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnEnqueueClick" Text="{x:Bind loc:UiStrings.MenuAddToQueue}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnTogglePlayedClick" Text="{x:Bind loc:UiStrings.MenuMarkPlayedToggle}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnSaveToPlaylistClick" Text="{x:Bind loc:UiStrings.MenuSaveToPlaylist}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnShareEpisodeClick" Text="{x:Bind loc:UiStrings.MenuShare}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.6"
                            Text="{x:Bind NumberText}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border
                            Grid.Column="1"
                            Width="100"
                            Height="56"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="4">
                            <TextBlock
                                FontSize="16"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                FontSize="14"
                                MaxLines="2"
                                Opacity="0.6"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#E03E52"
                                    Text="{x:Bind loc:UiStrings.PodcastFilterPlayed}"
                                    Visibility="{x:Bind IsPlayed, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.55"
                                    Text="•"
                                    Visibility="{x:Bind IsPlayed, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.55"
                                    Text="{x:Bind PublishedText}"
                                    Visibility="{x:Bind HasPublished, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.55"
                                    Text="•"
                                    Visibility="{x:Bind HasDuration, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.55"
                                    Text="{x:Bind DurationDisplay}"
                                    Visibility="{x:Bind HasDuration, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <!-- Red-on-grey playback progress strip (ytmusic-playback-progress-renderer). -->
                            <ProgressBar
                                Width="220"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Foreground="#E03E52"
                                Maximum="1"
                                Value="{x:Bind Progress}"
                                Visibility="{x:Bind HasProgress, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Content="&#xE712;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnSaveForLaterClick" Text="{x:Bind loc:UiStrings.MenuQueueForLater}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xECC8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnPlayNextClick" Text="{x:Bind loc:UiStrings.MenuPlayNext}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B0;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnEnqueueClick" Text="{x:Bind loc:UiStrings.MenuAddToQueue}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnTogglePlayedClick" Text="{x:Bind loc:UiStrings.MenuMarkPlayedToggle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnSaveToPlaylistClick" Text="{x:Bind loc:UiStrings.MenuSaveToPlaylist}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8FD;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnShareEpisodeClick" Text="{x:Bind loc:UiStrings.MenuShare}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Row="2"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>

