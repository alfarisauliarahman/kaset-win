<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.ExploreDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KasetWin.App.Behaviors"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:parsers="using:KasetWin.Core.Services.Api.Parsers"
    xmlns:views="using:KasetWin.App.Views"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Music videos: wide 16:9 cards + "Lihat semua". -->
        <DataTemplate x:Key="VideoSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <Grid>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button HorizontalAlignment="Right" Click="OnChartSeeAllClick" Content="{x:Bind loc:UiStrings.SeeAll}" Tag="{x:Bind}" />
                </Grid>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <!-- ContextRequested (not a static ContextFlyout): the card is polymorphic,
                                     and only SONG cards get the YT-Music-style right-click menu. -->
                                <Grid Width="256" Padding="8" Background="Transparent" ContextRequested="OnCardContextRequested" CornerRadius="8" DataContext="{x:Bind}" Tapped="OnItemClick">
                                    <StackPanel Spacing="2">
                                        <Border Width="240" Height="135" Margin="0,0,0,4" CornerRadius="8">
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock FontSize="15" MaxLines="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock FontSize="13" MaxLines="1" Opacity="0.7" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- A single horizontal "shelf" of cards for one section (shared shape with ExplorePage). -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <!--
                                    Grid root (not a Button): a Button must not contain the nested
                                    circular Play Button, since a Button-inside-a-Button breaks the
                                    outer control's hit-testing and the card click never reaches
                                    FeedNavigation.Activate. The Grid hit-tests via its Background,
                                    navigates on Tapped, is keyboard focusable (Enter/Space), and
                                    shows a subtle hover background; the Play Button is a sibling
                                    layered over the cover image.
                                -->
                                <Grid
                                    Width="{x:Bind CardWidth}"
                                    Padding="8"
                                    Background="Transparent"
                                    ContextRequested="OnCardContextRequested"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick"
                                    UseSystemFocusVisuals="True">
                                    <Border
                                        x:Name="CardHover"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                    <StackPanel Spacing="2">
                                        <Grid
                                            Width="{x:Bind TileWidth}"
                                            Height="{x:Bind TileHeight}"
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{x:Bind ImageCornerRadius}"
                                                Visibility="{x:Bind IsNotMood, Converter={StaticResource BoolToVisibility}}">
                                                <Image
                                                    Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <Button
                                                x:Name="PlayOverlay"
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="OnCardPlay"
                                                CornerRadius="22"
                                                GotFocus="OnPlayOverlayGotFocus"
                                                IsHitTestVisible="False"
                                                LostFocus="OnPlayOverlayLostFocus"
                                                Opacity="0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="{x:Bind loc:UiStrings.PlayLabel}"
                                                ToolTipService.ToolTip="{x:Bind loc:UiStrings.PlayLabel}"
                                                Visibility="{x:Bind CanPlay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                            </Button>
                                            <!-- Mood/genre chip, YT Music style: dark card with a small
                                                 colour bar at the left + the category name (no cover art). -->
                                            <Border
                                                Padding="12,0"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{x:Bind IsMood, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="12">
                                                    <Border
                                                        Width="4"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind ChipBrush}"
                                                        CornerRadius="2" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        MaxLines="2"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsNotMood, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            FontSize="13"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind IsNotMood, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Moods & genres (full category list): YT Music-style chips — dark cards with a small
             colour bar at the left + the name — flowing left-to-right, wrapping (no h-scroll),
             grouped under the server's own "Mood & momen" / "Genre" section headers. -->
        <DataTemplate x:Key="MoodSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                    <controls:ItemsRepeater.Layout>
                        <controls:UniformGridLayout
                            MinColumnSpacing="8"
                            MinItemHeight="48"
                            MinItemWidth="220"
                            MinRowSpacing="8"
                            Orientation="Horizontal" />
                    </controls:ItemsRepeater.Layout>
                    <controls:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeCardItem">
                            <Grid
                                Width="220"
                                Height="48"
                                Padding="12,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="12"
                                CornerRadius="6"
                                DataContext="{x:Bind}"
                                IsTabStop="True"
                                KeyDown="OnCardKeyDown"
                                Tapped="OnItemClick"
                                UseSystemFocusVisuals="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="4"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind ChipBrush}"
                                    CornerRadius="2" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MaxLines="1"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </controls:ItemsRepeater.ItemTemplate>
                </controls:ItemsRepeater>
            </StackPanel>
        </DataTemplate>

        <!-- Top artists chart: numbered, column-major list (4 rows/column) with a circular photo,
             coloured movement arrow, rank number and subscriber count (YT Music "Artis teratas"). -->
        <DataTemplate x:Key="ArtistChartSectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout
                                MaximumRowsOrColumns="4"
                                MinColumnSpacing="24"
                                MinRowSpacing="6"
                                Orientation="Vertical" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Grid
                                    Width="440"
                                    Height="64"
                                    Padding="6,4"
                                    Background="Transparent"
                                    ColumnSpacing="10"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    PointerEntered="OnChartCardEnter"
                                    PointerExited="OnChartCardExit"
                                    Tapped="OnItemClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        VerticalAlignment="Center"
                                        CornerRadius="24">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                    </Border>
                                    <FontIcon
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{x:Bind TrendBrush}"
                                        Glyph="{x:Bind TrendGlyph}"
                                        Visibility="{x:Bind HasTrend, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind RankText}" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <views:HomeSectionTemplateSelector
            x:Key="SectionTemplateSelector"
            ArtistChartTemplate="{StaticResource ArtistChartSectionTemplate}"
            ChartTemplate="{StaticResource SectionTemplate}"
            MoodTemplate="{StaticResource MoodSectionTemplate}"
            ShelfTemplate="{StaticResource SectionTemplate}"
            VideoTemplate="{StaticResource VideoSectionTemplate}" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <!-- Charts only (collapsed elsewhere): the country picker YT Music shows on its
                         Charts page. Options come from the charts response itself, so the list is
                         never hardcoded; picking a country reloads just this charts feed. -->
                    <ComboBox
                        x:Name="ChartsCountryPicker"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.ChartCountries}"
                        SelectedItem="{x:Bind ViewModel.SelectedChartCountry, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.HasChartCountries, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="parsers:ChartCountry">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource SectionTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <Button
                    x:Name="LoadMoreButton"
                    HorizontalAlignment="Center"
                    Click="OnLoadMoreClick"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
