<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:DurationToTextConverter x:Key="DurationToText" />
        <converters:TrendToGlyphConverter x:Key="TrendToGlyph" />
        <converters:TrendToBrushConverter x:Key="TrendToBrush" />
        <converters:RankToVisibilityConverter x:Key="RankToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: artwork + metadata + actions -->
        <Grid
            Grid.Row="0"
            Padding="24,24,24,12"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="160"
                Height="160"
                VerticalAlignment="Top"
                CornerRadius="8">
                <Image
                    x:Name="CoverImage"
                    Source="{x:Bind ViewModel.ThumbnailUrl, Converter={StaticResource UriToImageSource}, Mode=OneWay}"
                    Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="6">
                <TextBlock
                    MaxLines="2"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <!-- Creator: avatar + name (clickable to the artist page when a channel id exists). -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasArtistThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{x:Bind ViewModel.ArtistThumbnailUrl, Converter={StaticResource UriToImageSource}, Mode=OneWay}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <HyperlinkButton
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.NavigateToArtistCommand}"
                        Style="{StaticResource InlineLinkButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind loc:UiStrings.MenuGoToArtist}"
                        Visibility="{x:Bind ViewModel.HasAuthorLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource HyperlinkButtonForeground}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.AuthorDisplay, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </HyperlinkButton>
                    <TextBlock
                        VerticalAlignment="Center"
                        MaxLines="1"
                        Opacity="0.8"
                        Text="{x:Bind ViewModel.AuthorDisplay, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.AuthorIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>

                <!-- Description, when the playlist carries one. -->
                <TextBlock
                    MaxLines="3"
                    Opacity="0.72"
                    Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- Track count · total running time -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.TrackCountDisplay, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Opacity="0.6"
                        Text="{x:Bind ViewModel.AlbumDurationDisplay, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasAlbumDuration, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <Grid Margin="0,8,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.PlayAllCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Name="PlayButtonLabel" Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSharePlaylistClick" ToolTipService.ToolTip="{x:Bind loc:UiStrings.TipSharePlaylist}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72D;" />
                            <TextBlock Text="{x:Bind loc:UiStrings.MenuShare}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnDeletePlaylistClick"
                        Visibility="{x:Bind ViewModel.CanDelete, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock x:Name="DeleteButtonLabel" Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                    <!-- Bottom-right header menu (mirrors YT Music's playlist menu). -->
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{x:Bind loc:UiStrings.TipMore}"
                        ToolTipService.ToolTip="{x:Bind loc:UiStrings.TipMore}">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShufflePlayCommand}" Text="{x:Bind loc:UiStrings.MenuShufflePlay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.StartMixCommand}" Text="{x:Bind loc:UiStrings.MenuStartMix}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9D9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnEditPlaylistClick" Text="{x:Bind loc:UiStrings.MenuEditPlaylist}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.PlayAllNextCommand}" Text="{x:Bind loc:UiStrings.MenuPlayNext}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE893;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddAlbumToQueueCommand}" Text="{x:Bind loc:UiStrings.MenuAddToQueue}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnSharePlaylistClick" Text="{x:Bind loc:UiStrings.MenuShare}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnDeletePlaylistClick"
                                    Text="{x:Bind loc:UiStrings.MenuDeletePlaylist}"
                                    Visibility="{x:Bind ViewModel.CanDelete, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Track list -->
        <ListView
            x:Name="TracksList"
            Grid.Row="1"
            Padding="12,0,12,12"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid
                        Padding="8,6"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Chart rank + trend arrow (only shown for chart playlist rows). -->
                        <StackPanel
                            Grid.Column="0"
                            MinWidth="52"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind Rank, Converter={StaticResource RankToVisibility}}">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{x:Bind Trend, Converter={StaticResource TrendToBrush}}"
                                Glyph="{x:Bind Trend, Converter={StaticResource TrendToGlyph}}" />
                            <TextBlock
                                MinWidth="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind Rank}"
                                TextAlignment="Right" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            CornerRadius="4">
                            <Image
                                Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                Stretch="UniformToFill" />
                        </Border>
                        <controls:TrackInfo Grid.Column="2" Song="{x:Bind}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <Button
                    x:Name="LoadMoreButton"
                    Margin="8,12"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
