<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:DurationToTextConverter x:Key="DurationToText" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: artwork + metadata + actions -->
        <Grid
            Grid.Row="0"
            Padding="24,24,24,12"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="160"
                Height="160"
                VerticalAlignment="Top"
                CornerRadius="8">
                <Image
                    Source="{x:Bind ViewModel.ThumbnailUrl, Converter={StaticResource UriToImageSource}, Mode=OneWay}"
                    Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="6">
                <TextBlock
                    MaxLines="2"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <!-- Artist: clickable to the artist page when a channel id exists, plain otherwise (Req 37.1). -->
                <HyperlinkButton
                    Command="{x:Bind ViewModel.NavigateToArtistCommand}"
                    Style="{StaticResource InlineLinkButtonStyle}"
                    ToolTipService.ToolTip="Go to artist"
                    Visibility="{x:Bind ViewModel.HasAuthorLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{ThemeResource HyperlinkButtonForeground}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.AuthorDisplay, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </HyperlinkButton>
                <TextBlock
                    MaxLines="1"
                    Opacity="0.8"
                    Text="{x:Bind ViewModel.AuthorDisplay, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.AuthorIsPlain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.TrackCountDisplay, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.PlayAllCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.DeleteCommand}"
                        Visibility="{x:Bind ViewModel.CanDelete, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Track list -->
        <ListView
            x:Name="TracksList"
            Grid.Row="1"
            Padding="12,0,12,12"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid
                        Padding="8,6"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="4">
                            <Image
                                Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                Stretch="UniformToFill" />
                        </Border>
                        <controls:TrackInfo Grid.Column="1" Song="{x:Bind}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <Button
                    Margin="8,12"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
