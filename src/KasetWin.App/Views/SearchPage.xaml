<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KasetWin.App.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:core="using:KasetWin.Core.Models"
    xmlns:vm="using:KasetWin.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:DurationToTextConverter x:Key="DurationToText" />

        <!-- Apple-Music-style compact song row (used inside the multi-column Songs grid). -->
        <DataTemplate x:Key="SongTemplate" x:DataType="core:Song">
            <Button
                Width="380"
                HorizontalContentAlignment="Stretch"
                Click="OnSongClick"
                DataContext="{x:Bind}"
                Style="{StaticResource SubtleButtonStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="4">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <controls:TrackInfo Grid.Column="1" Song="{Binding}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="{Binding Duration, Converter={StaticResource DurationToText}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Album card (square art + title + artists), Apple-Music rail style. -->
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="core:Album">
            <Button
                Width="176"
                Padding="8"
                Click="OnAlbumClick"
                DataContext="{x:Bind}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Spacing="2">
                    <Border
                        Width="152"
                        Height="152"
                        Margin="0,0,0,4"
                        CornerRadius="8">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        FontSize="15"
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        FontSize="13"
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{Binding ArtistsDisplay}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Artist card: big circular photo + centred name. -->
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="core:Artist">
            <Button
                Width="150"
                Padding="8"
                Click="OnArtistClick"
                DataContext="{x:Bind}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Spacing="6">
                    <Border
                        Width="126"
                        Height="126"
                        HorizontalAlignment="Center"
                        CornerRadius="63">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        FontSize="15"
                        HorizontalAlignment="Center"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        FontSize="12"
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Opacity="0.6"
                        Text="{Binding SubtitleText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Playlist card. -->
        <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="core:Playlist">
            <Button
                Width="176"
                Padding="8"
                Click="OnPlaylistClick"
                DataContext="{x:Bind}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Spacing="2">
                    <Border
                        Width="152"
                        Height="152"
                        Margin="0,0,0,4"
                        CornerRadius="8">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        FontSize="15"
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        FontSize="13"
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{Binding Author.Name}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Podcast card. -->
        <DataTemplate x:Key="PodcastCardTemplate" x:DataType="core:Playlist">
            <Button
                Width="176"
                Padding="8"
                Click="OnPodcastClick"
                DataContext="{x:Bind}"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Spacing="2">
                    <Border
                        Width="152"
                        Height="152"
                        Margin="0,0,0,4"
                        CornerRadius="8">
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        FontSize="15"
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        FontSize="13"
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{Binding Author.Name}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Query box with live suggestions (Req 12.2 / 12.3). -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="0"
            MaxWidth="640"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
            PlaceholderText="Search songs, albums, artists, playlists"
            QueryIcon="Find"
            QuerySubmitted="OnQuerySubmitted"
            TextChanged="OnSearchTextChanged" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24">

                <ProgressRing
                    Margin="0,12"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!-- Top Results: a prominent Apple-Music-style card. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasTopResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Top Results" />
                    <Button
                        MaxWidth="620"
                        MinWidth="440"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnTopResultClick"
                        CornerRadius="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="{x:Bind ViewModel.TopResultThumbWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.TopResultThumbHeight, Mode=OneWay}"
                                VerticalAlignment="Center"
                                CornerRadius="{x:Bind ViewModel.TopResultThumbCorner, Mode=OneWay}">
                                <Image Source="{x:Bind ViewModel.TopResultThumbnail, Mode=OneWay, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="18"
                                    MaxLines="2"
                                    Text="{x:Bind ViewModel.TopResultTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.7"
                                    Text="{x:Bind ViewModel.TopResultSubtitle, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Artists: circular rail. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasArtists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Artists" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater ItemTemplate="{StaticResource ArtistCardTemplate}" ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="12" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Albums: card rail. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Albums" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater ItemTemplate="{StaticResource AlbumCardTemplate}" ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="12" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Unified results (podcast queries): YT's shelves verbatim, no classification. -->
                <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.UnifiedSections, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsUnifiedResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Orientation="Vertical" Spacing="24" />
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchUnifiedSection">
                            <!-- ItemsRepeater does not set DataContext on realized items (WinUI gotcha);
                                 x:Bind it explicitly so the inner {Binding}s resolve. -->
                            <StackPanel DataContext="{x:Bind}" Spacing="10">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <muxc:ItemsRepeater ItemsSource="{Binding Rows}">
                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:StackLayout Orientation="Vertical" Spacing="2" />
                                    </muxc:ItemsRepeater.Layout>
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchRow">
                                            <Button
                                                Padding="8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnUnifiedRowClick"
                                                DataContext="{x:Bind}"
                                                Style="{StaticResource SubtleButtonStyle}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="48"
                                                        Height="48"
                                                        CornerRadius="6">
                                                        <Image Source="{Binding Thumbnail, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="1">
                                                        <TextBlock
                                                            FontSize="15"
                                                            MaxLines="1"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock
                                                            FontSize="13"
                                                            MaxLines="1"
                                                            Opacity="0.7"
                                                            Text="{Binding Subtitle}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Songs: multi-column wrap grid (Apple-Music style). -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Songs" />
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource SongTemplate}" ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                MinColumnSpacing="16"
                                MinItemHeight="60"
                                MinItemWidth="380"
                                MinRowSpacing="2"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </StackPanel>

                <!-- Music Videos: wide 16:9 rail. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasMusicVideos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Music Videos" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.MusicVideos, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="12" />
                            </muxc:ItemsRepeater.Layout>
                            <muxc:ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="core:Song">
                                    <Button
                                        Width="264"
                                        Padding="8"
                                        Click="OnSongClick"
                                        DataContext="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <StackPanel Spacing="2">
                                            <Border
                                                Width="248"
                                                Height="139"
                                                Margin="0,0,0,4"
                                                CornerRadius="8">
                                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                FontSize="15"
                                                MaxLines="2"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                FontSize="13"
                                                MaxLines="1"
                                                Opacity="0.7"
                                                Text="{Binding ArtistsDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </muxc:ItemsRepeater.ItemTemplate>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Playlists: card rail. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Playlists" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater ItemTemplate="{StaticResource PlaylistCardTemplate}" ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="12" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Podcasts: card rail. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasPodcasts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Podcasts" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater ItemTemplate="{StaticResource PodcastCardTemplate}" ItemsSource="{x:Bind ViewModel.Podcasts, Mode=OneWay}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="12" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Episodes: multi-column wrap grid (episode rows play on click). -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasEpisodes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Episodes" />
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource SongTemplate}" ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                MinColumnSpacing="16"
                                MinItemHeight="60"
                                MinItemWidth="380"
                                MinRowSpacing="2"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </StackPanel>

                <!-- Empty state. -->
                <TextBlock
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    Opacity="0.6"
                    Text="No results found"
                    Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
