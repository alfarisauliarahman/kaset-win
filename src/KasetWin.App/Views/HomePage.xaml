<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A single favorited item card (Req 29.4); mirrors the section card chrome. -->
        <DataTemplate x:Key="FavoriteCardTemplate" x:DataType="vm:FavoriteCardItem">
            <Button
                Width="168"
                Padding="8"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="OnFavoriteClick"
                CornerRadius="8">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OnShareFavorite" IsEnabled="{x:Bind CanShare}" Text="Share" />
                        <MenuFlyoutItem Click="OnRemoveFromFavorites" Text="Remove from Favorites" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <StackPanel Spacing="8">
                    <Border
                        Width="152"
                        Height="152"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{x:Bind ImageCornerRadius}">
                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A single horizontal "shelf" of cards for one section. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCardItem">
                                <Button
                                    Width="168"
                                    Padding="8"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnItemClick"
                                    CornerRadius="8">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnShareItem" IsEnabled="{x:Bind CanShare}" Text="Share" />
                                            <MenuFlyoutItem Click="OnAddToFavorites" Text="Add to Favorites" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="152"
                                            Height="152"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="{x:Bind ImageCornerRadius}">
                                            <Image
                                                Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Home" />

                <!-- Favorites shelf (Req 29.4): shown only when there are pinned items. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Favorites" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <controls:ItemsRepeater ItemTemplate="{StaticResource FavoriteCardTemplate}" ItemsSource="{x:Bind ViewModel.Favorites}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                            </controls:ItemsRepeater.Layout>
                        </controls:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource SectionTemplate}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>

                <Button
                    HorizontalAlignment="Center"
                    Click="OnLoadMoreClick"
                    Content="Load more"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
