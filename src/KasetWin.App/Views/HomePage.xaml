<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KasetWin.App.Behaviors"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:KasetWin.App.Views"
    xmlns:vm="using:KasetWin.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A single favorited item card (Req 29.4); mirrors the section card chrome. -->
        <DataTemplate x:Key="FavoriteCardTemplate" x:DataType="vm:FavoriteCardItem">
            <Button
                Width="168"
                Padding="8"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="OnFavoriteClick"
                CornerRadius="8"
                DataContext="{x:Bind}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OnShareFavorite" IsEnabled="{x:Bind CanShare}" Text="Share" />
                        <MenuFlyoutItem Click="OnRemoveFromFavorites" Text="Remove from Favorites" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <StackPanel Spacing="8">
                    <Border
                        Width="152"
                        Height="152"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{x:Bind ImageCornerRadius}">
                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- The standard Home card (song/album/playlist/artist), shared by the section shelves. -->
        <DataTemplate x:Key="HomeCardTemplate" x:DataType="vm:HomeCardItem">
                                <!--
                                    The card root is a Grid (not a Button): a Button must not contain
                                    the nested circular Play Button, because a Button-inside-a-Button
                                    breaks the outer control's hit-testing/invocation and the card
                                    click stops reaching FeedNavigation.Activate. The Grid has a
                                    Background for hit-testing, navigates on Tapped, is keyboard
                                    focusable (IsTabStop) and activates on Enter/Space, and shows a
                                    subtle hover background like a ListViewItem. The Play Button is a
                                    SIBLING layered over the cover image inside the inner Grid.
                                -->
                                <Grid
                                    Width="{x:Bind CardWidth}"
                                    Padding="8"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    DataContext="{x:Bind}"
                                    IsTabStop="True"
                                    KeyDown="OnCardKeyDown"
                                    PointerEntered="OnCardPointerEntered"
                                    PointerExited="OnCardPointerExited"
                                    Tapped="OnItemClick"
                                    UseSystemFocusVisuals="True">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnShareItem" IsEnabled="{x:Bind CanShare}" Text="Share" />
                                            <MenuFlyoutItem Click="OnAddToFavorites" Text="Add to Favorites" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border
                                        x:Name="CardHover"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Opacity="0" />
                                    <StackPanel Spacing="2">
                                        <Grid
                                            Width="{x:Bind TileWidth}"
                                            Height="{x:Bind TileHeight}"
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="{x:Bind ImageCornerRadius}">
                                                <Image
                                                    Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <Button
                                                x:Name="PlayOverlay"
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="OnCardPlay"
                                                CornerRadius="22"
                                                GotFocus="OnPlayOverlayGotFocus"
                                                IsHitTestVisible="False"
                                                LostFocus="OnPlayOverlayLostFocus"
                                                Opacity="0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Play"
                                                Visibility="{x:Bind CanPlay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            HorizontalAlignment="Stretch"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextAlignment="{x:Bind CardTextAlignment}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <!-- Subtitle: clickable to the artist page when it names a real artist. -->
                                        <HyperlinkButton
                                            Padding="0"
                                            HorizontalAlignment="{x:Bind SubtitleHorizontalAlignment}"
                                            Click="OnSubtitleArtistClick"
                                            Tag="{x:Bind ArtistId}"
                                            Visibility="{x:Bind HasArtistLink, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{ThemeResource HyperlinkButtonForeground}"
                                                MaxLines="1"
                                                Text="{x:Bind Subtitle}"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </HyperlinkButton>
                                        <TextBlock
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"
                                            MaxLines="1"
                                            Opacity="0.7"
                                            Text="{x:Bind Subtitle}"
                                            TextAlignment="{x:Bind CardTextAlignment}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind SubtitleIsPlain, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
        </DataTemplate>

        <!-- A single horizontal "shelf" of cards for one section. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock
                    Text="{x:Bind Title}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemTemplate="{StaticResource HomeCardTemplate}" ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- One compact "Quick picks" row: thumb + title + subtitle (top-level so its x:Bind is not
             an inline nested template, which crashes the XAML compiler). -->
        <DataTemplate x:Key="QuickPickRowTemplate" x:DataType="vm:HomeCardItem">
            <Grid
                Width="460"
                Height="56"
                Padding="6,4"
                Background="Transparent"
                ColumnSpacing="12"
                CornerRadius="8"
                DataContext="{x:Bind}"
                PointerEntered="OnChartCardEnter"
                PointerExited="OnChartCardExit"
                Tapped="OnItemClick">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center" CornerRadius="4">
                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        MaxLines="1"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Quick picks / Pilihan cepat: compact column-major song list (4 rows per column). -->
        <DataTemplate x:Key="QuickPicksTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemTemplate="{StaticResource QuickPickRowTemplate}" ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout
                                MaximumRowsOrColumns="4"
                                MinColumnSpacing="24"
                                MinRowSpacing="4"
                                Orientation="Vertical" />
                        </controls:ItemsRepeater.Layout>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListenAgainTemplate" x:DataType="vm:HomeSectionView">
            <StackPanel Margin="0,0,0,8" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="28">
                        <Image Source="{x:Bind AccountAvatarUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.7"
                            Text="{x:Bind AccountName}"
                            Visibility="{x:Bind HasAccountName, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ListenAgainTitle}" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer
                    behaviors:VerticalWheelForwarder.IsEnabled="True"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <controls:ItemsRepeater ItemTemplate="{StaticResource HomeCardTemplate}" ItemsSource="{x:Bind Items}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                        </controls:ItemsRepeater.Layout>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <views:HomeSectionTemplateSelector
            x:Key="HomeSectionSelector"
            ListenAgainTemplate="{StaticResource ListenAgainTemplate}"
            QuickPicksTemplate="{StaticResource QuickPicksTemplate}"
            ShelfTemplate="{StaticResource SectionTemplate}" />

    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="24">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Home" />

                <!-- Favorites shelf (Req 29.4): shown only when there are pinned items. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Favorites" />
                    <ScrollViewer
                        behaviors:VerticalWheelForwarder.IsEnabled="True"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <controls:ItemsRepeater ItemTemplate="{StaticResource FavoriteCardTemplate}" ItemsSource="{x:Bind ViewModel.Favorites}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="16" />
                            </controls:ItemsRepeater.Layout>
                        </controls:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <controls:ItemsRepeater
                    ItemTemplate="{StaticResource HomeSectionSelector}"
                    ItemsSource="{x:Bind ViewModel.Sections}">
                    <controls:ItemsRepeater.Layout>
                        <controls:StackLayout Orientation="Vertical" Spacing="24" />
                    </controls:ItemsRepeater.Layout>
                </controls:ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
