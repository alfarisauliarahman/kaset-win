<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.LikedSongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:KasetWin.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:DurationToTextConverter x:Key="DurationToText" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PageTitleText"
            Grid.Row="0"
            Margin="24,24,24,12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Liked Songs" />

        <ListView
            x:Name="TracksList"
            Grid.Row="1"
            Padding="12,0,12,12"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <!-- Background=Transparent: without it the row's empty space is not
                         hit-testable, so right-click would only work directly over text/thumbnail
                         (same gotcha as PodcastShowPage/PlaylistPage). -->
                    <Grid Padding="8,6" Background="Transparent" ColumnSpacing="12">
                        <!-- Right-click menu (YT-Music-style, context-appropriate): queue actions
                             always; Go-to-album / Go-to-artist only when the row carries a real id. -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Tag="{x:Bind}" Click="OnTrackPlayNextClick" Text="{x:Bind loc:UiStrings.MenuPlayNext}" />
                                <MenuFlyoutItem Tag="{x:Bind}" Click="OnTrackAddToQueueClick" Text="{x:Bind loc:UiStrings.MenuAddToQueue}" />
                                <MenuFlyoutItem
                                    Tag="{x:Bind}"
                                    Click="OnTrackOpenAlbumClick"
                                    Text="{x:Bind loc:UiStrings.MenuGoToAlbum}"
                                    Visibility="{x:Bind HasAlbumLink, Converter={StaticResource BoolToVisibility}}" />
                                <MenuFlyoutItem
                                    Tag="{x:Bind}"
                                    Click="OnTrackOpenArtistClick"
                                    Text="{x:Bind loc:UiStrings.MenuGoToArtist}"
                                    Visibility="{x:Bind HasArtistLink, Converter={StaticResource BoolToVisibility}}" />
                                <MenuFlyoutItem Tag="{x:Bind}" Click="OnTrackShareClick" Text="{x:Bind loc:UiStrings.MenuShare}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="4">
                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Opacity="0.75"
                            Text="{x:Bind ArtistsDisplay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Opacity="0.6"
                            Text="{x:Bind Album.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="4"
                            MinWidth="42"
                            VerticalAlignment="Center"
                            HorizontalTextAlignment="Right"
                            Opacity="0.6"
                            Text="{x:Bind Duration, Converter={StaticResource DurationToText}}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
