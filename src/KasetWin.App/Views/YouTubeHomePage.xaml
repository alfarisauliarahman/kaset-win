<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasetWin.App.Views.YouTubeHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KasetWin.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KasetWin.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:UriToImageSourceConverter x:Key="UriToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="YouTubeVideoCardTemplate" x:DataType="models:YouTubeVideo">
            <Grid Width="260" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Height="146"
                    CornerRadius="8">
                    <Image
                        Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                    <TextBlock
                        MaxLines="2"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ChannelName}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        MaxLines="1"
                        Opacity="0.7"
                        Text="{x:Bind ViewCountText}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="24,24,24,12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="YouTube" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="12,0,12,12">
                <!-- Shorts rail (Req 32.4) -->
                <TextBlock
                    Margin="12,4,12,4"
                    Text="Shorts"
                    Visibility="{x:Bind ViewModel.HasShorts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView
                    x:Name="ShortsList"
                    IsItemClickEnabled="True"
                    ItemClick="OnShortClick"
                    ItemsSource="{x:Bind ViewModel.Shorts, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:YouTubeVideo">
                            <Grid Width="132" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    Height="234"
                                    CornerRadius="8">
                                    <Image
                                        Source="{x:Bind ThumbnailUrl, Converter={StaticResource UriToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="2,6,2,0"
                                    MaxLines="2"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Recommended videos grid (Req 32.1) -->
                <TextBlock
                    Margin="12,16,12,4"
                    Text="Recommended"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView
                    x:Name="VideosList"
                    IsItemClickEnabled="True"
                    ItemClick="OnVideoClick"
                    ItemTemplate="{StaticResource YouTubeVideoCardTemplate}"
                    ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                    SelectionMode="None" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="1"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Page>
